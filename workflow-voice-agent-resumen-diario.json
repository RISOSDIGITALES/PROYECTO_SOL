    {
      "id": "d3",
      "name": "📊 Preparar Resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "jsCode": "\nconst today = new Date().toISOString().split('T')[0];\nconst rows  = $input.all().map(r => r.json).filter(r => r.fechaLlamada === today && r.skip !== 'TRUE' && r.skip !== true);\n\nif (rows.length === 0) return [{ json: { skip: true } }];\n\nconst NAVY = '#305468', ORANGE = '#ff6900';\nconst badge = { cotizacion:'🔥 Cotización', informacion:'ℹ️ Información', urgente:'🚨 URGENTE', no_interesado:'❌ No interesado', otro:'📌 Otro', sin_transcript:'📵 Sin audio' };\n\nconst filas = rows.map(r => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${r.callerPhone||'—'}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${r.nombre||'—'}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\"><span style=\"background:${ORANGE};color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;\">${badge[r.interes]||r.interes||'—'}</span></td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${r.duration||0}s</td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;font-size:12px;color:#555;\">${r.notas||'—'}</td>\n  </tr>`).join('');\n\nconst fecha = new Date().toLocaleDateString('es-US',{weekday:'long',year:'numeric',month:'long',day:'numeric'});\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:680px;margin:0 auto;color:#333;\">\n  <div style=\"background:${NAVY};color:#fff;padding:20px 24px;border-radius:8px 8px 0 0;\">\n    <div style=\"font-size:11px;letter-spacing:1px;opacity:.7;text-transform:uppercase;\">CE Voice Agent — Marco</div>\n    <h2 style=\"margin:4px 0 0;font-size:20px;\">📞 Resumen de Llamadas — ${fecha}</h2>\n    <p style=\"margin:6px 0 0;opacity:.8;font-size:13px;\">${rows.length} llamada(s) recibida(s) hoy</p>\n  </div>\n  <div style=\"padding:20px 24px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px;\">\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;\">\n      <thead><tr style=\"background:#f5f5f5;\">\n        <th style=\"padding:8px;text-align:left;\">Teléfono</th>\n        <th style=\"padding:8px;text-align:left;\">Nombre</th>\n        <th style=\"padding:8px;text-align:left;\">Interés</th>\n        <th style=\"padding:8px;text-align:left;\">Duración</th>\n        <th style=\"padding:8px;text-align:left;\">Notas</th>\n      </tr></thead>\n      <tbody>${filas}</tbody>\n    </table>\n    <hr style=\"margin:20px 0;border:none;border-top:1px solid #eee;\">\n    <p style=\"font-size:12px;color:#999;\">CE Voice Agent — Generado automáticamente por n8n</p>\n  </div>\n</div>`;\n\nreturn [{ json: { subject: `📞 Marco: ${rows.length} llamada(s) hoy — ${fecha}`, body_html: html } }];\n"
      }
    },
