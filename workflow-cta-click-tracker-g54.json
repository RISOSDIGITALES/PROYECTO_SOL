{
  "name": "🔗 CTA Click Tracker (G54)",
  "nodes": [
    {
      "id": "webhook-click",
      "name": "🔔 Webhook: Clic CTA",
      "type": "n8n-nodes-base.webhook",
      "position": [
        200,
        300
      ],
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "GET",
        "path": "cta-click-g54",
        "options": {},
        "responseMode": "responseNode"
      },
      "webhookId": "c16fb858-4df9-4b44-af9e-11149655aa43"
    },
    {
      "id": "config-node",
      "name": "⚙️ Config Growth54",
      "type": "n8n-nodes-base.set",
      "position": [
        420,
        300
      ],
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "g54-base-url",
              "name": "G54_BASE_URL",
              "value": "https://apigrowth.mdarthurdigital.com",
              "type": "string"
            },
            {
              "id": "g54-agent-token",
              "name": "G54_AGENT_TOKEN",
              "value": "REDACTED_AGENT_TOKEN",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "preparar-click",
      "name": "🔧 Preparar Click",
      "type": "n8n-nodes-base.code",
      "position": [
        640,
        300
      ],
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const q = $('🔔 Webhook: Clic CTA').item.json.query || {};\nconst company = q.company || '';\nconst platform = (q.platform === 'instagram') ? 'instagram' : 'facebook';\nconst dest = q.dest || '';\n// Solo redirige a http(s) real — evita que este endpoint se use como open-redirect genérico\nconst destValida = typeof dest === 'string' && /^https?:\\/\\//.test(dest);\nconst hoy = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: { company, platform, dest, destValida, hoy }\n}];"
      }
    },
    {
      "id": "if-dest-valida",
      "name": "🔀 ¿Dest válida?",
      "type": "n8n-nodes-base.if",
      "position": [
        860,
        300
      ],
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.destValida }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "sumar-clic",
      "name": "💾 G54: Sumar Clic",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1080,
        200
      ],
      "typeVersion": 4.1,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config Growth54').item.json.G54_BASE_URL + '/api/agent/rrss/metricas' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('⚙️ Config Growth54').item.json.G54_AGENT_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "options": {},
        "jsonBody": "={{ ({ company_id: parseInt($('🔧 Preparar Click').item.json.company) || null, metricas: [{ platform: $('🔧 Preparar Click').item.json.platform, period_start: $('🔧 Preparar Click').item.json.hoy, period_end: $('🔧 Preparar Click').item.json.hoy, clics: 1 }] }) }}"
      }
    },
    {
      "id": "responder-redirect",
      "name": "📤 Redirigir",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1300,
        200
      ],
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "text",
        "responseBody": "",
        "options": {
          "responseCode": 302,
          "responseHeaders": {
            "entries": [
              {
                "name": "Location",
                "value": "={{ $('🔧 Preparar Click').item.json.dest }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "responder-error",
      "name": "❌ Responder Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1080,
        420
      ],
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "text",
        "responseBody": "Link inválido.",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "🔔 Webhook: Clic CTA": {
      "main": [
        [
          {
            "node": "⚙️ Config Growth54",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⚙️ Config Growth54": {
      "main": [
        [
          {
            "node": "🔧 Preparar Click",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔧 Preparar Click": {
      "main": [
        [
          {
            "node": "🔀 ¿Dest válida?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔀 ¿Dest válida?": {
      "main": [
        [
          {
            "node": "💾 G54: Sumar Clic",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "❌ Responder Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "💾 G54: Sumar Clic": {
      "main": [
        [
          {
            "node": "📤 Redirigir",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}