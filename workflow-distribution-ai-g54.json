    {
      "id": "norm-posts",
      "name": "🔧 Normalizar Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\n\n// Limpiar IDs de más de 30 días\nconst THIRTY_DAYS = 30 * 24 * 3600000;\nconst now = Date.now();\nconst recentEntries = (staticData.publishedPostIdsList || []).filter(e => now - e.ts < THIRTY_DAYS);\nstaticData.publishedPostIdsList = recentEntries;\nstaticData.publishedPostIds = recentEntries.map(e => e.id);\n\nconst publishedIds = new Set(staticData.publishedPostIds);\n\nconst raw = $input.item.json;\nconst posts = Array.isArray(raw) ? raw : (raw.data || []);\n\n// Filtrar posts ya publicados (aunque G54 siga mostrándolos como 'aprobado')\nconst pendientes = posts.filter(p => !publishedIds.has(String(p.id || '')));\n\nreturn pendientes.map(p => ({ json: p }));\n"
      }
    },
