    {
      "parameters": {
        "jsCode": "\nconst postId = $('🔧 Preparar Datos Post').item?.json?.post_id || 'desconocido';\nconst g54Status = $('✅ G54: Estado → Publicado').item?.json?.status || 'sin respuesta';\nconst ts = new Date().toLocaleString('es-CR', {timeZone:'America/New_York'});\n\nreturn [{\n  json: {\n    mensaje: `Post ${postId} publicado en FB/IG y marcado en G54 como publicado.`,\n    timestamp_miami: ts,\n    g54_response: g54Status,\n  }\n}];\n"
      },
