    {
      "id": "prep-post",
      "name": "🔧 Preparar Datos Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        140
      ],
      "parameters": {
        "jsCode": "\n// Normalize field names (API may use snake_case or nested fields object)\nconst p = $input.item.json;\nconst f = p.fields || p;\n\nconst post_id        = p.id || p.record_id || '';\nconst copy_facebook  = f.copy_facebook  || f.Post_Facebook_EN || f.post_facebook  || '';\nconst copy_instagram = f.copy_instagram || f.Post_Instagram_EN || f.post_instagram || '';\nconst imagen_url     = f.imagen_url     || f.imagen            || '';\n\nreturn [{\n  json: {\n    post_id,\n    copy_facebook,\n    copy_instagram,\n    imagen_url,\n    has_image: !!imagen_url,\n  }\n}];\n"
      }
    },
