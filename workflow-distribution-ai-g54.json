        "url": "={{ $('🏢 Aplicar Config').item.json.G54_BASE_URL + '/api/agent/rrss/posts/' + $('🔧 Preparar Datos Post').item.json.post_id + '/mark-published' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('🏢 Aplicar Config').item.json.G54_AGENT_TOKEN }}"
