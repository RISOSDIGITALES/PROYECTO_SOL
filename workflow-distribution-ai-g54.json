0], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1}, "conditions": [{"id": "c1", "leftValue": "={{ Array.isArray($json) ? $json.length : ($json.data ? $json.data.length : 0) }}", "rightValue": 0, "operator": {"type": "number", "operation": "gt"}}], "combinator": "and"}, "options": {}}}, {"id": "no-posts", "name": "⚠️ Sin posts para publicar", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, 460], "parameters": {}}, {"id": "norm-posts", "name": "🔧 Normalizar Posts", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 300], "parameters": {"jsCode": "\nconst raw = $input.item.json;\n// API may return array directly or { data: [] }\nconst posts = Array.isArray(raw) ? raw : (raw.data || []);\n// Return one item per post\nreturn posts.map(p => ({ json: p }));\n"}}, {"id": "if-img", "name": "🖼️ ¿Tiene imagen?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [880, 300], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1}, "conditions": [{"id": "c1", "leftValue": "={{ $json.imagen_url || $json.fields?.imagen_url || '' }}", "rightValue": "", "operator": {"type": "string", "operation": "notEquals"}}], "combinator": "and"}, "options": {}}}, {"id": "prep-post", "name": "🔧 Preparar Datos Post", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, 140], "parameters": {"jsCode": "\n// Normalize field names (API may use snake_case or nested fields object)\nconst p = $input.item.json;\nconst f = p.fields || p;\n\nconst post_id        = p.id || p.record_id || '';\nconst copy_facebook  = f.copy_facebook  || f.Post_Facebook_EN || f.post_facebook  || '';\nconst copy_instagram = f.copy_instagram || f.Post_Instagram_EN || f.post_instagram || '';\nconst imagen_url     = f.imagen_url     || f.imagen            || '';\n\nreturn [{\n  json: {\n    post_id,\n    copy_facebook,\n    copy_instagram,\n    imagen_url,\n    has_image: !!imagen_url,\n  }\n}];\n"}}, {"id": "fb-photo", "name": "📘 FB: Publicar con Foto", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 140], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('⚙️ Config Distribution').item.json.FB_PAGE_ID }}/photos", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "url", "value": "={{ $('🔧 Preparar Datos Post').item.json.imagen_url }}"}, {"name": "caption", "value": "={{ $('🔧 Preparar Datos Post').item.json.copy_facebook }}"}, {"name": "access_token", "value": "={{ $('⚙️ Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "fb-text", "name": "📘 FB: Publicar Solo Texto", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 460], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('⚙️ Config Distribution').item.json.FB_PAGE_ID }}/feed", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "message", "value": "={{ $('🔧 Preparar Datos Post').item.json.copy_facebook }}"}, {"name": "access_token", "value": "={{ $('⚙️ Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "ig-container", "name": "📸 IG: Crear Container", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1320, 140], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('⚙️ Config Distribution').item.json.IG_USER_ID }}/media", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "image_url", "value": "={{ $('🔧 Preparar Datos Post').item.json.imagen_url }}"}, {"name": "caption", "value": "={{ $('🔧 Preparar Datos Post').item.json.copy_instagram }}"}, {"name": "access_token", "value": "={{ $('⚙️ Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "if-ig-ok", "name": "🔀 ¿IG Container OK?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1540, 140], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1}, "conditions": [{"id": "c1", "leftValue": "={{ $json.id || '' }}", "rightValue": "", "operator": {"type": "string", "operation": "notEquals"}}], "combinator": "and"}, "options": {}}}, {"id": "ig-publish", "name": "📸 IG: Publicar", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1760, 100], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('⚙️ Config Distribution').item.json.IG_USER_ID }}/media_publish", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "creation_id", "value": "={{ $json.id }}"}, {"name": "access_token", "value": "={{ $('⚙️ Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "ig-skip", "name": "⚠️ IG: Skip (container falló)", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1760, 200], "parameters": {}}, {"id": "merge-pub", "name": "🔀 Merge Publicaciones", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1980, 300], "parameters": {"mode": "combine", "combinationMode": "mergeByPosition", "options": {}}}, {"id": "g54-pub", "name": "✅ G54: Estado → Publicado", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2200, 300], "continueOnFail": true, "parameters": {"method": "PUT", "url": "={{ $('⚙️ Config Distribution').item.json.G54_BASE_URL + '/api/rrss/posts/' + $('🔧 Preparar Datos Post').item.json.post_id + '/status' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $('⚙️ Config Distribution').item.json.G54_AGENT_TOKEN }}"}, {"name": "Content-Type", "value": "application/json"}, {"name": "Accept", "value": "application/jso