    {
      "parameters": {
        "jsCode": "const config = $('⚙️ Config Distribution').item.json;\nconst pageData = $('🔑 Obtener Tokens Página (G54)').item.json;\nconst igData = $('📷 Obtener IG User ID (Meta)').item.json;\n\nconst ig_user_id = igData?.instagram_business_account?.id || pageData.ig_user_id || '';\n\nlet fb_access_token = pageData.fb_access_token || config.FB_ACCESS_TOKEN || '';\ntry {\n  const exchanged = $('🔑 Intercambiar Page Token (FB)').item.json;\n  if (exchanged && exchanged.access_token) fb_access_token = exchanged.access_token;\n} catch (e) {}\n\nreturn [{json: {\n  ...config,\n  FB_ACCESS_TOKEN: fb_access_token,\n  IG_USER_ID: ig_user_id\n}}];"
      },
      "id": "dist-apply-tokens",
      "name": "🏢 Aplicar Tokens Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        688
      ]
    },
    {
      "parameters": {
        "jsCode": "const webhook = $('🌐 Webhook: Publicar Post').item?.json?.body || {};\nconst postId = webhook.post_id;\nconst posts = $('📥 Obtener Posts a Publicar (G54)').item.json.data || [];\nconst filtered = postId ? posts.filter(p => String(p.id) === String(postId)) : posts;\nif (!filtered.length) return [];\nreturn filtered.map(p => ({ json: p }));"
      },
