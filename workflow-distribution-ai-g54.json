    {
      "id": "norm-posts",
      "name": "🔧 Normalizar Posts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "// At this point $input.item.json is already a single post (from Filtrar)\nconst p = $input.item.json;\n// If it's a single post object with id, pass it through\nif (p.id) return [{ json: p }];\n// Fallback: if somehow array came through\nconst posts = Array.isArray(p) ? p : (p.data || []);\nreturn posts.map(post => ({ json: post }));"
      }
    },
    {
      "id": "if-img",
      "name": "🖼️ ¿Tiene imagen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.imagen_url || $json.fields?.imagen_url || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "prep-post",
      "name": "🔧 Preparar Datos Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        140
      ],
      "parameters": {
        "jsCode": "const p = $input.item.json;\nconst f = p.fields || p;\nconst config = $('⚙️ Config Distribution').item.json;\n\nconst post_id        = p.id || p.record_id || '';\nconst copy_facebook  = f.copy_facebook  || f.Post_Facebook_EN || '';\nconst copy_instagram = f.copy_instagram || f.Post_Instagram_EN || '';\nconst imagen_url     = f.imagen_url     || f.imagen || '';\n\n// Token from post, fallback to pages API\nconst FB_ACCESS_TOKEN = p.access_token || $('🏢 Aplicar Tokens Empresa').item.json.FB_ACCESS_TOKEN || '';\n// FB_PAGE_ID: always use the one from Config (G54 currently sends IG account ID in page_id field)\nconst FB_PAGE_ID = config.FB_PAGE_ID || '1713965015486703';\n// IG_USER_ID from post or pages API\nconst IG_USER_ID = p.instagram_account_id || $('🏢 Aplicar Tokens Empresa').item.json.IG_USER_ID || '';\n\nreturn [{json: {\n  post_id, copy_facebook, copy_instagram, imagen_url,\n  has_image: !!imagen_url,\n  FB_ACCESS_TOKEN, FB_PAGE_ID, IG_USER_ID\n}}];"
      }
    },
    {
      "id": "fb-photo",
      "name": "📘 FB: Publicar con Foto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        140
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.FB_PAGE_ID }}/photos",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.imagen_url }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.copy_facebook }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.FB_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
