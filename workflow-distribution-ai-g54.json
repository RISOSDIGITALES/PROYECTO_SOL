    {
      "id": "reporte",
      "name": "📊 Reporte Publicación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        300
      ],
      "parameters": {
        "jsCode": "\nconst postId = $('🔧 Preparar Datos Post').item?.json?.post_id || 'desconocido';\nconst g54Status = $('✅ G54: Estado → Publicado').item?.json?.status || 'sin respuesta';\nconst ts = new Date().toLocaleString('es-CR', {timeZone:'America/New_York'});\n\nreturn [{\n  json: {\n    mensaje: `Post ${postId} publicado en FB/IG y marcado en G54 como publicado.`,\n    timestamp_miami: ts,\n    g54_response: g54Status,\n  }\n}];\n"
      }
    },
    {
      "id": "dist-page-tokens",
      "name": "🔑 Obtener Tokens Página (G54)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1840,
        80
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $('⚙️ Config Distribution').item.json.G54_BASE_URL + '/api/n8n/pages/' + $('⚙️ Config Distribution').item.json.FB_PAGE_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "dist-apply-tokens",
      "name": "🏢 Aplicar Tokens Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1640,
        80
      ],
      "parameters": {
        "jsCode": "const config = $('⚙️ Config Distribution').item.json;\nconst pageData = $('🔑 Obtener Tokens Página (G54)').item.json;\nreturn [{json: {\n  ...config,\n  FB_ACCESS_TOKEN: pageData.fb_access_token || config.FB_ACCESS_TOKEN || '',\n  IG_USER_ID: pageData.ig_user_id || config.IG_USER_ID || ''\n}}];"
      }
    },
    {
      "id": "dist-filter-post",
      "name": "🔍 Filtrar Post por ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1400,
        80
      ],
      "parameters": {
        "jsCode": "const webhook = $('🌐 Webhook: Publicar Post').item?.json?.body || {};\nconst postId = webhook.post_id;\nconst posts = $('📥 Obtener Posts a Publicar (G54)').item.json.data || [];\nconst filtered = postId ? posts.filter(p => String(p.id) === String(postId)) : posts;\nif (!filtered.length) return [];\nreturn filtered.map(p => ({ json: p }));"
      }
    },
    {
      "id": "error-g54-node-001",
      "name": "♻️ G54: Revertir → Aprobado",
