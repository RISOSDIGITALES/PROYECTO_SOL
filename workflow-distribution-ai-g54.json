    {
      "id": "get-posts",
      "name": "📥 Obtener Posts a Publicar (G54)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.G54_BASE_URL }}/api/n8n/companies/{{ $json.G54_COMPANY_ID }}/rrss/posts/to-publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('⚙️ Config Distribution').item.json.G54_N8N_TOKEN }}"
