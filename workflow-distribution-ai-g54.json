    {
      "id": "reporte",
      "name": "📊 Reporte Publicación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nconst postId = String($('🔧 Preparar Datos Post').item?.json?.post_id || '');\n\n// Guardar ID como publicado para no volver a publicarlo (workaround mientras PUT /status requiere sesión)\nif (postId && postId !== 'desconocido') {\n  if (!staticData.publishedPostIdsList) staticData.publishedPostIdsList = [];\n  // Evitar duplicados\n  if (!staticData.publishedPostIdsList.find(e => e.id === postId)) {\n    staticData.publishedPostIdsList.push({ id: postId, ts: Date.now() });\n  }\n  staticData.publishedPostIds = staticData.publishedPostIdsList.map(e => e.id);\n}\n\nconst g54Status = $('✅ G54: Estado → Publicado').item?.json?.status || 'sin respuesta (PUT requiere sesión — post guardado en memoria)';\nconst ts = new Date().toLocaleString('es-CR', {timeZone:'America/New_York'});\n\nreturn [{\n  json: {\n    mensaje: `Post ${postId} publicado en FB/IG. Guardado en memoria para evitar republicación.`,\n    timestamp_miami: ts,\n    g54_response: g54Status,\n    total_ids_memoria: (staticData.publishedPostIds || []).length,\n  }\n}];\n"
      }
    },
