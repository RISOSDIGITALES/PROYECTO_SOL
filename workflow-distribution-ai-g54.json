Version": 2.2, "position": [880, 300], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1}, "conditions": [{"id": "c1", "leftValue": "={{ $json.imagen_url || $json.fields?.imagen_url || '' }}", "rightValue": "", "operator": {"type": "string", "operation": "notEquals"}}], "combinator": "and"}, "options": {}}}, {"id": "prep-post", "name": "\ud83d\udd27 Preparar Datos Post", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [880, 140], "parameters": {"jsCode": "\n// Normalize field names (API may use snake_case or nested fields object)\nconst p = $input.item.json;\nconst f = p.fields || p;\n\nconst post_id        = p.id || p.record_id || '';\nconst copy_facebook  = f.copy_facebook  || f.Post_Facebook_EN || f.post_facebook  || '';\nconst copy_instagram = f.copy_instagram || f.Post_Instagram_EN || f.post_instagram || '';\nconst imagen_url     = f.imagen_url     || f.imagen            || '';\n\nreturn [{\n  json: {\n    post_id,\n    copy_facebook,\n    copy_instagram,\n    imagen_url,\n    has_image: !!imagen_url,\n  }\n}];\n"}}, {"id": "fb-photo", "name": "\ud83d\udcd8 FB: Publicar con Foto", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 140], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('\u2699\ufe0f Config Distribution').item.json.FB_PAGE_ID }}/photos", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "url", "value": "={{ $('\ud83d\udd27 Preparar Datos Post').item.json.imagen_url }}"}, {"name": "caption", "value": "={{ $('\ud83d\udd27 Preparar Datos Post').item.json.copy_facebook }}"}, {"name": "access_token", "value": "={{ $('\u2699\ufe0f Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "fb-text", "name": "\ud83d\udcd8 FB: Publicar Solo Texto", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1100, 460], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('\u2699\ufe0f Config Distribution').item.json.FB_PAGE_ID }}/feed", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "message", "value": "={{ $('\ud83d\udd27 Preparar Datos Post').item.json.copy_facebook }}"}, {"name": "access_token", "value": "={{ $('\u2699\ufe0f Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "ig-container", "name": "\ud83d\udcf8 IG: Crear Container", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1320, 140], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('\u2699\ufe0f Config Distribution').item.json.IG_USER_ID }}/media", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "image_url", "value": "={{ $('\ud83d\udd27 Preparar Datos Post').item.json.imagen_url }}"}, {"name": "caption", "value": "={{ $('\ud83d\udd27 Preparar Datos Post').item.json.copy_instagram }}"}, {"name": "access_token", "value": "={{ $('\u2699\ufe0f Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "if-ig-ok", "name": "\ud83d\udd00 \u00bfIG Container OK?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1540, 140], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1}, "conditions": [{"id": "c1", "leftValue": "={{ $json.id || '' }}", "rightValue": "", "operator": {"type": "string", "operation": "notEquals"}}], "combinator": "and"}, "options": {}}}, {"id": "ig-publish", "name": "\ud83d\udcf8 IG: Publicar", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1760, 100], "continueOnFail": true, "parameters": {"method": "POST", "url": "=https://graph.facebook.com/v19.0/{{ $('\u2699\ufe0f Config Distribution').item.json.IG_USER_ID }}/media_publish", "sendBody": true, "contentType": "form-urlencoded", "bodyParameters": {"parameters": [{"name": "creation_id", "value": "={{ $json.id }}"}, {"name": "access_token", "value": "={{ $('\u2699\ufe0f Config Distribution').item.json.FB_ACCESS_TOKEN }}"}]}, "options": {}}}, {"id": "ig-skip", "name": "\u26a0\ufe0f IG: Skip (container fall\u00f3)", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [1760, 200], "parameters": {}}, {"id": "merge-pub", "name": "\ud83d\udd00 Merge Publicaciones", "type": "n8n-nodes-base.merge", "typeVersion": 3, "position": [1980, 300], "parameters": {"mode": "combine", "combinationMode": "mergeByPosition", "options": {}}}, {"id": "g54-pub", "name": "\u2705 G54: Estado \u2192 Publicado", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [2200, 300], "continueOnFail": true, "parameters": {"method": "POST", "url": "={{ $('\u2699\ufe0f Config Distribution').item.json.G54_BASE_URL + '/api/agent/rrss/posts/' + $('\ud83d\udd27 Preparar Datos Post').item.json.post_id + '/mark-published' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{ 'Bearer ' + $('\u2699\ufe0f Config Distribution').item.json.G54_AGENT_TOKEN }}"}, {"name": "Content-Type", "value": "application/json"}, {"name": "Accept", "value": "application/json"}]}, "options": {}}}, {"id": "reporte", "name": "\ud83d\udcca Reporte Publicaci\u00f3n", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2420, 300], "parameters": {"jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nconst postId = String($('\ud83d\udd27 Preparar Datos Post').item?.json?.post_id || '');\n\n// Guardar ID como publicado para no volver a publicarlo (workaround mientras PUT /status requiere sesi\u00f3n)\nif (postId && postId !== 'desconocido') {\n  if (!staticData.publishedPostIdsList) staticData.publishedPostIdsList = [];\n  // Evitar duplicados\n  if (!staticData.publishedPostIdsList.find(e => e.id === postId)) {\n    staticData.publishedPostIdsList.push({ id: postId, ts: Date.now() });\n  }\n  staticData.publishedPostIds = staticData.publishedPostIdsList.map(e => e.id);\n}\n\nconst g54Status = $('\u2705 G54: Estado \u2192 Publicado').item?.json?.status || 'sin respuesta (PUT requiere sesi\u00f3n \u2014 post guardado en memoria)';\nconst ts = new Date().toLocaleString('es-CR', {timeZone:'America/New_York'});\n\nreturn [{\n  json: {\n    mensaje: `Post ${postId} publicado en FB/IG. Guardado en memoria para evitar republicaci\u00f3n.`,\n    timestamp_miami: ts,\n    g54_response: g54Status,\n    total_ids_memoria: (staticData.publishedPostIds || []).length,\n  }\n}];\n"}}], "name": "\ud83d\udce2 Distribution AI \u2014 Crating Express v1.0 (G54)"}