    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst config = $('⚙️ Config Distribution').item.json;\nconst tokens = $('🏢 Aplicar Tokens Empresa').item.json;\n\nreturn items.map(item => {\n  const p = item.json;\n  const f = p.fields || p;\n\n  const post_id        = p.id || p.record_id || '';\n  const copy_facebook  = f.copy_facebook  || f.Post_Facebook_EN || '';\n  const copy_instagram = f.copy_instagram || f.Post_Instagram_EN || '';\n  const imagen_url     = f.imagen_url     || f.imagen || '';\n  const platform       = f.platform || p.platform || 'Facebook';\n\n  const FB_ACCESS_TOKEN = tokens.FB_ACCESS_TOKEN || p.access_token || '';\n  const FB_PAGE_ID = config.FB_PAGE_ID || '1713965015486703';\n  const IG_USER_ID = p.instagram_account_id || tokens.IG_USER_ID || '';\n\n  return { json: {\n    post_id, copy_facebook, copy_instagram, imagen_url,\n    has_image: !!imagen_url, platform,\n    FB_ACCESS_TOKEN, FB_PAGE_ID, IG_USER_ID\n  } };\n});"
      },
