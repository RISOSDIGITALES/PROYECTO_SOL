      "parameters": {
        "jsCode": "// Procesa TODOS los items que llegaron (uno por post pendiente), no solo el primero\nconst items = $input.all();\nconst result = [];\nfor (const item of items) {\n  const p = item.json;\n  if (p && p.id) {\n    result.push({ json: p });\n  } else if (p) {\n    const posts = Array.isArray(p) ? p : (p.data || []);\n    for (const post of posts) result.push({ json: post });\n  }\n}\nreturn result;"
      },
