    {
      "id": "parsear-post-es",
      "name": "🔍 Parsear Post Español",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2550, 300],
      "parameters": {
        "jsCode": "const aiResponse = $input.item.json.message?.content || $input.item.json.choices?.[0]?.message?.content || '{}';\nlet post;\ntry {\n  post = JSON.parse(aiResponse);\n} catch(e) {\n  // Intentar extraer JSON si viene con texto extra\n  const match = aiResponse.match(/\\{[\\s\\S]*\\}/);\n  post = match ? JSON.parse(match[0]) : {};\n}\n\nconst contexto = $('🔧 Preparar Contexto para IA').item.json;\n\nreturn [{\n  json: {\n    ...contexto,\n    hook_es: post.hook || '',\n    mensaje_es: post.mensaje || '',\n    cta_es: post.cta || '',\n    hashtags: post.hashtags || '',\n    texto_canva_titulo: post.texto_canva_titulo || '',\n    texto_canva_subtitulo: post.texto_canva_subtitulo || ''\n  }\n}];"
      }
    },
