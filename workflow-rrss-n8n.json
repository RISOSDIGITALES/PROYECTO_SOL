    {
      "id": "preparar-contexto",
      "name": "🔧 Preparar Contexto para IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2050, 300],
      "parameters": {
        "jsCode": "// Extraer datos de los nodos anteriores\nconst empresa = $('📊 Obtener Perfil Empresa').item.json.records[0]?.fields || {};\nconst productosData = $('📦 Obtener Servicios Activos').item.json.records || [];\nconst tema = $('📅 Obtener Próximo Tema Semanal').item.json.records[0];\n\nconst servicios = productosData\n  .map(p => `- ${p.fields['Nombre de Servicio']}: ${p.fields['Descripción comercial']}`.slice(0, 200))\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      empresa_nombre: empresa['﻿nombre_empresa'] || 'Crating Express',\n      empresa_descripcion: empresa['descripción_corta'] || '',\n      empresa_propuesta_valor: empresa['propuesta_valor'] || '',\n      empresa_ciudad: empresa['ciudad base'] || 'Miami, FL',\n      empresa_web: empresa['sitio_web'] || 'cratingexpress.com',\n      empresa_telefono: empresa['teléfono'] || '',\n      servicios_resumen: servicios,\n      tema_id: tema.id,\n      tema_texto: tema.fields['Tema'],\n      tema_descripcion: tema.fields['Descripcion'] || '',\n      tema_palabras_clave: tema.fields['Palabras_Clave'] || '',\n      tema_semana: tema.fields['Semana_Numero'] || 1,\n      fecha_post: new Date().toISOString().split('T')[0]\n    }\n  }\n];"
      }
    },
