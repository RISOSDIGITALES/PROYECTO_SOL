# ── Base de datos (MariaDB / MySQL) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=planilla_nicaragua

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Cambia este valor por cualquier cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# ── Puerto del servidor (opcional, default: 3000) ─────────────────────────────
# PORT=3000

# ── URL pública de la app (para enlaces en correos) ───────────────────────────
APP_URL=http://localhost:3000

# ── SMTP para envío de correos (recuperación de contraseña, confirmaciones) ───
# Si no se configura, los correos se omiten silenciosamente.
#
# Ejemplo con Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=tu_contraseña_de_aplicacion   ← generar en myaccount.google.com > Seguridad > Contraseñas de app
#   SMTP_FROM=tucorreo@gmail.com
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
