            "position": [
                240,
                300
            ],
            "webhookId": "cf7-cotizacion",
            "parameters": {
                "httpMethod": "POST",
                "path": "cf7-cotizacion",
                "responseMode": "responseNode",
                "options": {}
            }
        },
        {
            "id": "format-lead",
            "name": "\ud83d\udd27 Formatear Datos",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                480,
                300
            ],
            "parameters": {
                "jsCode": "\nconst b = $json.body || $json;\n\nconst nombre   = (b['nombre']      || '').toString().trim();\nconst email    = (b['email']       || '').toString().trim();\nconst telefono = (b['telefono']    || '').toString().trim();\nconst zip      = (b['ZipCode']     || '').toString().trim();\nconst producto = (b['Product']     || '').toString().trim();\nconst servicio = (b['Service']     || '').toString().trim();\nconst mensaje  = (b['Message']     || '').toString().trim();\nconst fecha    = (b['Fecha']       || new Date().toLocaleDateString('es-US',{timeZone:'America/New_York'})).toString().trim();\n\n// Build shipment details from all 5 rows\nconst filas = [\n  { cant: b['Cantidad'],  det: b['detalles'],  l: b['Length'],  w: b['Width'],  h: b['height'],  p: b['Weightaprox']  },\n  { cant: b['Cantidad2'], det: b['Detalles2'], l: b['Length2'], w: b['Width2'], h: b['height2'], p: b['Weightaprox2'] },\n  { cant: b['Cantidad3'], det: b['Detalles3'], l: b['Length3'], w: b['Width3'], h: b['height3'], p: b['Weightaprox3'] },\n  { cant: b['Cantidad4'], det: b['Detalles4'], l: b['Length4'], w: b['Width4'], h: b['height4'], p: b['Weightaprox4'] },\n  { cant: b['Cantidad5'], det: b['Detalles5'], l: b['Length5'], w: b['Width5'], h: b['height5'], p: b['Weightaprox5'] },\n];\n\nconst lineas = filas\n  .filter(f => f.det || f.l)\n  .map(f => `${f.cant||'1'}x ${f.det||'item'} \u2014 ${f.l||'?'}\u00d7${f.w||'?'}\u00d7${f.h||'?'} in / ${f.p||'?'} lbs`);\n\nconst detalles_embarque = lineas.join('\\n') || 'Sin dimensiones';\n\nconst resumen = [\n  `\ud83d\udce6 Producto: ${producto} / ${servicio}`,\n  `\ud83d\udcd0 Detalles:\\n${detalles_embarque}`,\n  mensaje ? `\ud83d\udcac Notas: ${mensaje}` : ''\n].filter(Boolean).join('\\n');\n\nconst fecha_captura = new Date().toLocaleDateString('es-US', {timeZone:'America/New_York'});\n\nreturn [{\n  json: {\n    // Para Leads Sheet\n    nombre,\n    email,\n    telefono,\n    direccion: `Zip: ${zip}`,\n    web: '',\n    rating: '',\n    fecha_captura,\n    correo_enviado: '0',\n    fecha_c1: '', fecha_c2: '', fecha_c3: '',\n    estado_email: 'activo',\n    estado: 'Cotizaci\u00f3n Web',\n    nicho: 'cotizacion-web',\n    // Para Airtable\n    zip, producto, servicio,\n    mensaje: resumen,\n    fecha_solicitud: fecha,\n  }\n}];\n"
            }
        },
        {
            "id": "save-leads-sheet",
            "name": "\ud83d\udcca Guardar en Leads Sheet",
