  {
   "parameters": {
    "mode": "runOnceForEachItem",
    "jsCode": "// Obtener nombre y web del nodo Formatear Lead (Hunter no preserva campos anteriores)\nconst leadData = $('🧹 Formatear Lead').item.json;\nconst nombre = leadData.nombre || '';\nconst web = leadData.web || '';\n\n// Hunter devuelve los emails en $json.data.emails (no en $json.hunterResult)\nlet email = '';\ntry {\n  const emails = $json.data?.emails || [];\n  if (emails.length > 0) {\n    const sorted = [...emails].sort((a, b) => (b.confidence || 0) - (a.confidence || 0));\n    email = sorted[0].value || '';\n  }\n} catch(e) {}\n\nreturn { json: { nombre, web, email } };"
   },
