          "value": {
            "row_number": "={{ $json.row_number }}",
            "estado_email": "={{ $json.estado_email_nuevo }}",
            "fecha_ultima_interaccion": "={{ $json.fecha_ultima_interaccion }}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "canBeUsedToMatch": true,
              "defaultMatch": true
            },
            {
              "id": "estado_email",
              "displayName": "estado_email",
              "canBeUsedToMatch": false,
              "defaultMatch": false
            },
            {
              "id": "fecha_ultima_interaccion",
              "displayName": "fecha_ultima_interaccion",
              "canBeUsedToMatch": false,
              "defaultMatch": false
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "gmon-notify-code",
      "name": "?? Preparar Notificaci�n",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        380
      ],
      "parameters": {
        "jsCode": "\nconst items = $input.all();\nif (items[0]?.json?.noReplies) return [{ json: { skipped: true } }];\n\nconst NAVY   = '#305468';\nconst ORANGE = '#ff6900';\nconst today  = new Date().toLocaleDateString('es-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });\n\nconst rows = items.map(i => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${i.json.nombre || '-'}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${i.json.email}</td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${i.json.asunto_respuesta || '-'}</td>\n  </tr>`).join('');\n\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:620px;margin:0 auto;color:#333;\">\n  <div style=\"background:${NAVY};color:#fff;padding:20px 24px;border-radius:8px 8px 0 0;\">\n    <div style=\"font-size:11px;letter-spacing:1px;opacity:.7;text-transform:uppercase;\">Gmail Monitor</div>\n    <h2 style=\"margin:4px 0 0;font-size:20px;\">?? ${items.length} Lead(s) respondieron</h2>\n    <p style=\"margin:6px 0 0;opacity:.8;font-size:13px;\">${today}</p>\n  </div>\n  <div style=\"padding:20px 24px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px;\">\n    <p>Hola Sol, estos leads respondieron uno de nuestros emails:</p>\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;\">\n      <thead>\n        <tr style=\"background:#f5f5f5;\">\n          <th style=\"padding:8px;text-align:left;\">Nombre</th>\n          <th style=\"padding:8px;text-align:left;\">Email</th>\n          <th style=\"padding:8px;text-align:left;\">Asunto</th>\n        </tr>\n      </thead>\n      <tbody>${rows}</tbody>\n    </table>\n    <p style=\"margin-top:16px;font-size:13px;color:#666;\">Su estado fue actualizado a <strong>\"respondi�\"</strong> en el CRM y no recibir�n m�s emails autom�ticos hasta que los contactes manualmente.</p>\n    <hr style=\"margin:20px 0;border:none;border-top:1px solid #eee;\">\n    <p style=\"font-size:12px;color:#999;\">CE Gmail Monitor - Generado autom�ticamente por n8n</p>\n  </div>\n</div>`;\n\nreturn [{ json: { subject: `?? ${items.length} lead(s) respondieron - ${today}`, body_html: html } }];\n"
      }
    },
