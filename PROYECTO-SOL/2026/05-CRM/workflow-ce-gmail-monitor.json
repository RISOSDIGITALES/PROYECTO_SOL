      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "QE2RlAxaMLoYefTD",
          "name": "Google Sheets account"
        }
      },
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1WRqv3s1vsTRSpfz6Bo27u3ff9kHDki_nDDMFt9yVj-8",
          "mode": "id"
