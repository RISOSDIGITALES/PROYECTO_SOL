    {
      "id": "gmon-match",
      "name": "?? Cruzar con Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "jsCode": "\nconst emails  = $('?? Leer Inbox Gmail').all();\nconst leads   = $('?? Obtener Leads').all();\n\n// Build lookup: email address ? lead row_number\nconst leadMap = {};\nfor (const l of leads) {\n  const d = l.json;\n  if (d.email) leadMap[d.email.toLowerCase().trim()] = d;\n}\n\nconst today   = new Date().toISOString().split('T')[0];\nconst replies = [];\n\nfor (const msg of emails) {\n  const m    = msg.json;\n  const from = (m.from || '').toLowerCase();\n\n  // Extract email address from \"Name <email@example.com>\" format\n  const match = from.match(/<(.+?)>/) || from.match(/([^\\s]+@[^\\s]+)/);\n  const senderEmail = match ? match[1].trim() : from.trim();\n\n  const lead = leadMap[senderEmail];\n  if (!lead) continue;  // not a known lead, skip\n\n  replies.push({\n    json: {\n      row_number:              lead.row_number,\n      email:                   senderEmail,\n      nombre:                  lead.nombre || '',\n      estado_email_nuevo:      'respondi�',\n      fecha_ultima_interaccion: today,\n      asunto_respuesta:        m.subject || '',\n      fecha_respuesta:         today\n    }\n  });\n}\n\nif (replies.length === 0) return [{ json: { noReplies: true } }];\nreturn replies;\n"
      }
    },
    {
      "id": "gmon-if",
      "name": "? �Hay respuestas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-replies",
              "leftValue": "={{ $json.noReplies }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
