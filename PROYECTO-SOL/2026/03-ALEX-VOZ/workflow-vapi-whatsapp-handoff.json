    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst msg = body.message;\n\nconst call = msg.call || {};\nconst telefono = (call.customer?.number || '').replace(/^\\+/, '');\nconst callId = call.id || '';\nconst transcript = msg.artifact?.transcript || '';\nconst messages = msg.artifact?.messages || [];\n\nconst historial = messages\n  .filter(m => m.role === 'user' || m.role === 'bot')\n  .map(m => `[Llamada] ${m.role === 'user' ? 'Cliente' : 'Alex'}: ${m.message || ''}`)\n  .join('\\n');\n\nreturn [{ json: {\n  telefono,\n  callId,\n  transcript,\n  historial: historial || `[Transcript] ${transcript.slice(0, 1000)}`\n}}];"
      },
      "id": "6e88c5a9-7c18-43e9-8c9e-720f60ad64e1",
      "name": "🔧 Extraer Datos Llamada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        1360
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/gpt-oss-120b', messages: [{ role: 'user', content: `Analiza este transcript de llamada de Crating Express y extrae la información. Responde SOLO con JSON válido:\\n\\nTranscript:\\n${$json.transcript.slice(0, 2000)}\\n\\nJSON requerido:\\n{\"producto\": \"\", \"medidas\": \"\", \"fecha\": \"\", \"nombre_cliente\": \"\", \"idioma\": \"es\"}` }], max_tokens: 2000, reasoning_effort: 'low', temperature: 0.1, response_format: { type: 'json_object' } }) }}",
        "options": {},
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi"
      },
      "id": "ea75eaf7-3561-4d85-abfb-9b3f8e721046",
      "name": "🤖 Groq: Extraer Datos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        1360
      ],
      "continueOnFail": true,
      "credentials": {
        "groqApi": {
          "id": "jORffbRhRNohHT1B",
          "name": "Groq API"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const extractData = $('🔧 Extraer Datos Llamada').item.json;\nconst groqRaw = $input.first().json;\n\nlet leadData = { producto: '', medidas: '', fecha: '', nombre_cliente: '', idioma: 'es' };\ntry {\n  const content = groqRaw.choices?.[0]?.message?.content || '{}';\n  leadData = { ...leadData, ...JSON.parse(content) };\n} catch(e) {}\n\nconst esEspanol = leadData.idioma !== 'en';\n\nconst mensajeWA = esEspanol\n  ? `Hola 👋 soy Alex de Crating Express. Continuamos por aquí.`\n  : `Hi 👋 this is Alex from Crating Express. Let's continue here.`;\n\nreturn [{ json: {\n  telefono: extractData.telefono,\n  callId: extractData.callId,\n  mensajeWA,\n  nombre_cliente: leadData.nombre_cliente || '',\n  producto: leadData.producto || '',\n  medidas: leadData.medidas || '',\n  fecha: leadData.fecha || '',\n  historial: extractData.historial\n}}];"
      },
      "id": "50390642-3c40-4336-a7ab-7b81c18a8912",
      "name": "🔧 Preparar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        1360
      ]
    },
    {
      "parameters": {
        "method": "POST",
