  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook: Groq Proxy",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "vox54-groq-proxy",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "5f8adc84-824f-4fcd-ad5f-7ad9a13b0a8a"
    },
    {
      "id": "check-secret",
      "name": "¿Secreto Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-relay-secret'] }}",
              "rightValue": "REDACTED_GROQ_RELAY_SECRET",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "groq-forward",
      "name": "Groq: Reenviar Body",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Webhook: Groq Proxy').item.json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi"
      },
      "credentials": {
        "groqApi": {
          "id": "jORffbRhRNohHT1B",
          "name": "Groq API"
        }
      }
    },
    {
      "id": "respond-ok",
      "name": "Responder: Resultado Groq",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ $json.statusCode }}"
        }
      }
    },
    {
      "id": "respond-401",
      "name": "Responder: 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        440,
        420
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"error\": \"secreto inválido\"} }}",
        "options": {
          "responseCode": 401
        }
      }
    }
  ],
