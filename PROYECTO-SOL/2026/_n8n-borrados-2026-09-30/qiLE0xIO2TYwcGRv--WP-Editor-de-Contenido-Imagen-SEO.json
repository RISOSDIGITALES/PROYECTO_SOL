    {
      "id": "a1b2c3d4-0004-0004-0004-000000000001",
      "name": "🔧 Detectar Builder y Preparar Creación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        240
      ],
      "parameters": {
        "jsCode": "const config = $('⚙️ Config').item.json;\n\n// Detectar builder desde post de referencia\nlet builderType = 'gutenberg'; // default seguro\ntry {\n  const posts = $('🔍 Obtener Post de Referencia (Builder)').item.json;\n  const refPost = Array.isArray(posts) ? posts[0] : posts;\n  if (refPost) {\n    const raw = refPost.content?.raw || refPost.content?.rendered || '';\n    const meta = refPost.meta || {};\n    if (raw.includes('[et_pb_')) {\n      builderType = 'divi';\n    } else if (raw.includes('<!-- wp:')) {\n      builderType = 'gutenberg';\n    } else if (meta._elementor_data && meta._elementor_data.length > 10) {\n      builderType = 'elementor';\n    } else if (raw.includes('elementor-section') || raw.includes('data-elementor-type')) {\n      builderType = 'elementor';\n    } else if (raw.trim().length > 0) {\n      builderType = 'classic';\n    }\n  }\n} catch(e) {}\n\n// Construir el contenido en el formato del builder detectado\nconst titulo = config.nuevo_titulo || 'Nuevo contenido';\nconst contenidoRaw = config.nuevo_contenido || '';\nconst tipoNuevo = config.tipo_nuevo || 'post';\n\nfunction buildGutenberg(texto) {\n  const parrafos = texto.split('\\n').filter(p => p.trim().length > 0);\n  return parrafos.map(p => `<!-- wp:paragraph -->\\n<p>${p.trim()}</p>\\n<!-- /wp:paragraph -->`).join('\\n\\n');\n}\n\nfunction buildDivi(texto) {\n  const parrafos = texto.split('\\n').filter(p => p.trim().length > 0);\n  const textContent = parrafos.map(p => `<p>${p.trim()}</p>`).join('\\n');\n  return `[et_pb_section fb_built=\"1\" _builder_version=\"4.0\"]\\n[et_pb_row _builder_version=\"4.0\"]\\n[et_pb_column type=\"4_4\" _builder_version=\"4.0\"]\\n[et_pb_text _builder_version=\"4.0\"]\\n${textContent}\\n[/et_pb_text]\\n[/et_pb_column]\\n[/et_pb_row]\\n[/et_pb_section]`;\n}\n\nfunction buildClassic(texto) {\n  const parrafos = texto.split('\\n').filter(p => p.trim().length > 0);\n  return parrafos.map(p => `<p>${p.trim()}</p>`).join('\\n');\n}\n\nlet wpContent = '';\nif (builderType === 'divi') {\n  wpContent = buildDivi(contenidoRaw);\n} else if (builderType === 'gutenberg') {\n  wpContent = buildGutenberg(contenidoRaw);\n} else {\n  wpContent = buildClassic(contenidoRaw);\n}\n\nreturn [{ json: {\n  wp_site_url: config.wp_site_url,\n  tipo_nuevo: tipoNuevo,\n  nuevo_titulo: titulo,\n  wpContent,\n  builderType,\n  image_url: config.image_url,\n  estado_publicacion: config.estado_publicacion || 'draft'\n}}];"
      }
    },
