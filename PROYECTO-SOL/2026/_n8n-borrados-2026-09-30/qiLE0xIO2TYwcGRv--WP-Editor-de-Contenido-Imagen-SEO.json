    {
      "id": "a1b2c3d4-0009-0009-0009-000000000001",
      "name": "🔧 Consolidar Resultado Creación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        240
      ],
      "parameters": {
        "jsCode": "let resultado = {};\ntry {\n  const post = $('✅ Crear Post').item.json;\n  if (post && post.id) resultado = post;\n} catch(e) {}\ntry {\n  const page = $('✅ Crear Página').item.json;\n  if (page && page.id && !resultado.id) resultado = page;\n} catch(e) {}\n\nconst ctx = $('🔧 Detectar Builder y Preparar Creación').item.json;\n\nreturn [{ json: {\n  tipo: ctx.tipo_nuevo,\n  content_id: String(resultado.id || ''),\n  wp_site_url: ctx.wp_site_url,\n  builderType: ctx.builderType,\n  nuevo_id: resultado.id || null,\n  nuevo_url: resultado.link || '',\n  titulo: resultado.title?.rendered || ctx.nuevo_titulo,\n  estado: resultado.status || 'desconocido'\n}}];"
      }
    },
