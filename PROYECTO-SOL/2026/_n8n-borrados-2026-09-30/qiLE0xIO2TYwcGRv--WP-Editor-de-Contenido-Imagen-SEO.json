    {
      "id": "5dbadd1a-244a-429d-9914-df2279304074",
      "name": "📊 Reporte Final SEO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        560
      ],
      "parameters": {
        "jsCode": "\nlet siteUrl = '';\ntry { siteUrl = $('🔧 Preparar SEO').item.json.wp_site_url; } catch(e) {}\nif (!siteUrl) { try { siteUrl = $('🔧 Detectar Builder y Preparar Creación').item.json.wp_site_url; } catch(e) {} }\n\nlet tipo_contenido = 'desconocido';\nlet content_id = '';\nlet builder_detectado = '';\ntry { tipo_contenido = $('🔧 Consolidar Tipo').item.json.tipo; content_id = $('🔧 Consolidar Tipo').item.json.content_id; } catch(e) {}\ntry { if (!tipo_contenido || tipo_contenido === 'desconocido') { const c = $('🔧 Consolidar Resultado Creación').item.json; tipo_contenido = c.tipo; content_id = String(c.nuevo_id||''); builder_detectado = c.builderType; } } catch(e) {}\n\n// Plugin SEO via namespaces\nlet plugin_seo = 'Ninguno detectado';\nlet plugin_seo_ok = false;\nlet sitemap_url = 'No encontrado';\nlet sitemap_tipo = 'N/A';\ntry {\n  const ns = $('🔍 WP: Listar Namespaces REST').item.json;\n  const namespaces = ns.namespaces || [];\n  if (namespaces.includes('rankmath/v1')) { plugin_seo = 'Rank Math'; plugin_seo_ok = true; }\n  else if (namespaces.includes('yoast/v1')) { plugin_seo = 'Yoast SEO'; plugin_seo_ok = true; }\n} catch(e) {}\n\n// Sitemap via Rank Math REST o fallback directo\ntry {\n  const sm = $('🗺️ WP: Verificar Sitemap REST').item.json;\n  if (sm && (sm.body || sm.xml || sm.url || JSON.stringify(sm).includes('sitemap'))) {\n    sitemap_url = siteUrl + '/sitemap_index.xml';\n    sitemap_tipo = plugin_seo !== 'Ninguno detectado' ? plugin_seo : 'Plugin SEO';\n  }\n} catch(e) {}\n\n// Sitemap fallback — check direct XML nodes\nif (sitemap_url === 'No encontrado') {\n  try {\n    const sn = $('🗺️ Verificar Sitemap Nativo').item.json;\n    const body = typeof sn === 'string' ? sn : JSON.stringify(sn);\n    if (body.includes('urlset') || body.includes('sitemapindex')) {\n      sitemap_url = siteUrl + '/wp-sitemap.xml';\n      sitemap_tipo = 'Nativo WordPress';\n    }\n  } catch(e) {}\n}\nif (sitemap_url === 'No encontrado') {\n  try {\n    const sp = $('🗺️ Verificar Sitemap Plugin').item.json;\n    const body = typeof sp === 'string' ? sp : JSON.stringify(sp);\n    if (body.includes('urlset') || body.includes('sitemapindex')) {\n      sitemap_url = siteUrl + '/sitemap_index.xml';\n      sitemap_tipo = plugin_seo !== 'Ninguno detectado' ? plugin_seo : 'Plugin SEO';\n    }\n  } catch(e) {}\n}\n\n// robots.txt\nlet robots_ok = false;\nlet robots_tiene_sitemap = false;\ntry {\n  const r = $('🤖 Verificar robots.txt').item;\n  const body = typeof r.json === 'string' ? r.json : (r.body || '');\n  robots_ok = body.includes('User-agent');\n  robots_tiene_sitemap = body.toLowerCase().includes('sitemap');\n  if (robots_ok && !sitemap_url.includes('http')) {\n    const match = body.match(/Sitemap:\\s*(https?:\\/\\/[^\\s]+)/i);\n    if (match) { sitemap_url = match[1]; sitemap_tipo = 'Desde robots.txt'; }\n  }\n} catch(e) {}\n\nconst recomendaciones = [];\nif (!plugin_seo_ok) recomendaciones.push('⚠️ No se detectó plugin SEO activo (Rank Math o Yoast)');\nif (!robots_ok) recomendaciones.push('⚠️ robots.txt no accesible externamente (verificar en navegador: ' + siteUrl + '/robots.txt)');\nelse if (!robots_tiene_sitemap && sitemap_url !== 'No encontrado') recomendaciones.push('⚠️ robots.txt no incluye directiva Sitemap: ' + sitemap_url);\nif (sitemap_url === 'No encontrado') recomendaciones.push('⚠️ Sitemap no detectado — activar en el plugin SEO');\n\nreturn [{ json: {\n  tipo_contenido,\n  content_id,\n  builder_detectado: builder_detectado || '(modo editar)',\n  plugin_seo,\n  plugin_seo_activo: plugin_seo_ok,\n  sitemap_url,\n  sitemap_tipo,\n  robots_txt_accesible: robots_ok,\n  robots_tiene_directiva_sitemap: robots_tiene_sitemap,\n  recomendaciones: recomendaciones.length ? recomendaciones : ['✅ Todo en orden'],\n}}];\n"
      }
    },
    {
      "id": "a1b2c3d4-0011-0011-0011-000000000001",
      "name": "🔧 Preparar SEO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        480
      ],
      "parameters": {
        "jsCode": "let wp_site_url = '';\nlet tipo = '';\nlet content_id = '';\n\n// Intentar ruta creación\ntry {\n  const c = $('🔧 Consolidar Resultado Creación').item.json;\n  if (c && c.wp_site_url) { wp_site_url = c.wp_site_url; tipo = c.tipo; content_id = String(c.nuevo_id || ''); }\n} catch(e) {}\n\n// Intentar ruta edición\nif (!wp_site_url) {\n  try {\n    const e = $('🔧 Consolidar Tipo').item.json;\n    if (e && e.wp_site_url) { wp_site_url = e.wp_site_url; tipo = e.tipo; content_id = e.content_id; }\n  } catch(e) {}\n}\n\nreturn [{ json: { wp_site_url, tipo, content_id } }];"
      }
    },
