  "name": "📤 WA Reply — Envío Manual desde G54",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "webhook-reply",
      "name": "📲 Webhook Responder",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "webhookId": "wa-reply-g54",
      "parameters": {
        "httpMethod": "POST",
        "path": "wa-reply-g54",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "resp-200",
      "name": "✅ Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        0,
        160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "cfg",
      "name": "⚙️ Config G54",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "G54_BASE_URL",
              "value": "https://apigrowth.mdarthurdigital.com",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "G54_AGENT_TOKEN",
              "value": "g54_agent_produccion_2026",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "preparar",
      "name": "🔧 Preparar Envío",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const body = $('📲 Webhook Responder').item.json.body || $('📲 Webhook Responder').item.json;\n\nconst phone = String(body.phone || '');\nconst message = String(body.message || '');\nconst company_id = String(body.company_id || '1');\n\n// TEMPORAL: fallback WA config por empresa hasta que G54 implemente el endpoint\nconst waFallbacks = {\n  '4': {\n    wa_access_token: 'PLACEHOLDER_ORISON_WA_TOKEN',\n    phone_number_id: '1220630761131252'\n  }\n};\n\nconst wa_access_token = waFallbacks[company_id]?.wa_access_token || '';\nconst phone_number_id = waFallbacks[company_id]?.phone_number_id || '';\n\nif (!phone || !message || !wa_access_token) {\n  throw new Error(`Faltan datos: phone=${phone}, message=${!!message}, token=${!!wa_access_token}`);\n}\n\nreturn [{ json: { phone, message, company_id, wa_access_token, phone_number_id } }];"
      }
    },
    {
      "id": "enviar-wa",
      "name": "📤 Enviar Mensaje WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v19.0/' + $json.phone_number_id + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.wa_access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'text', text: { body: $json.message } }) }}",
        "options": {}
      }
    },
    {
      "id": "guardar-g54",
      "name": "💾 Guardar en G54",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "={{ $('⚙️ Config G54').item.json.G54_BASE_URL + '/api/agent/whatsapp/inbound' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('⚙️ Config G54').item.json.G54_AGENT_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ empresa_id: Number($('🔧 Preparar Envío').item.json.company_id), phone: $('🔧 Preparar Envío').item.json.phone, messages: [{ rol: 'agent', contenido: $('🔧 Preparar Envío').item.json.message }] }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "📲 Webhook Responder": {
      "main": [
        [
          {
            "node": "✅ Responder 200",
            "type": "main",
