    {
      "id": "dd683929-bd22-410d-a803-7022324bfa75",
      "name": "🔧 Consolidar Tipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "jsCode": "\nconst config = $('⚙️ Config').item.json;\nlet tipo = 'desconocido';\nlet datos = {};\n\ntry {\n  const post = $('🔍 Detectar Tipo: Post').item.json;\n  if (post && post.id) { tipo = 'post'; datos = post; }\n} catch(e) {}\n\ntry {\n  const page = $('🔍 Detectar Tipo: Página').item.json;\n  if (page && page.id && tipo === 'desconocido') { tipo = 'página'; datos = page; }\n} catch(e) {}\n\nreturn [{\n  json: {\n    tipo,\n    content_id: config.content_id,\n    wp_site_url: config.wp_site_url,\n    nuevo_titulo: config.nuevo_titulo,\n    nuevo_contenido: config.nuevo_contenido,\n    image_url: config.image_url,\n    titulo_actual: datos.title?.rendered || '',\n    estado_actual: datos.status || '',\n    url_actual: datos.link || ''\n  }\n}];\n"
      }
    },
