    {
      "id": "5dbadd1a-244a-429d-9914-df2279304074",
      "name": "📊 Reporte Final SEO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        480
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('🔧 Consolidar Tipo').item.json;\nconst siteUrl = ctx.wp_site_url;\n\n// Plugin SEO\nlet plugin_seo = 'Ninguno detectado';\nlet plugin_seo_ok = false;\ntry {\n  const rm = $('🔍 SEO: Probar Rank Math').item.json;\n  if (rm && rm.head) { plugin_seo = 'Rank Math'; plugin_seo_ok = true; }\n} catch(e) {}\nif (!plugin_seo_ok) {\n  try {\n    const yoast = $('🔍 SEO: Probar Yoast').item.json;\n    if (yoast && yoast.head) { plugin_seo = 'Yoast SEO'; plugin_seo_ok = true; }\n  } catch(e) {}\n}\n\n// robots.txt\nlet robots_ok = false;\nlet robots_tiene_sitemap = false;\nlet robots_contenido = '';\ntry {\n  const r = $('🤖 Verificar robots.txt').item;\n  if (r && r.json && typeof r.json === 'string') {\n    robots_contenido = r.json;\n  } else if (r && r.binary) {\n    robots_contenido = '(binario)';\n  }\n  robots_ok = robots_contenido.includes('User-agent');\n  robots_tiene_sitemap = robots_contenido.toLowerCase().includes('sitemap');\n} catch(e) {}\n\n// Sitemap\nlet sitemap_url = '';\nlet sitemap_tipo = '';\ntry {\n  const sn = $('🗺️ Verificar Sitemap Nativo').item.json;\n  if (sn && (typeof sn === 'string' ? sn.includes('urlset') || sn.includes('sitemapindex') : false)) {\n    sitemap_url = siteUrl + '/wp-sitemap.xml';\n    sitemap_tipo = 'Nativo WordPress';\n  }\n} catch(e) {}\nif (!sitemap_url) {\n  try {\n    const sp = $('🗺️ Verificar Sitemap Plugin').item.json;\n    if (sp && (typeof sp === 'string' ? sp.includes('sitemap') : false)) {\n      sitemap_url = siteUrl + '/sitemap_index.xml';\n      sitemap_tipo = plugin_seo !== 'Ninguno detectado' ? plugin_seo : 'Plugin SEO';\n    }\n  } catch(e) {}\n}\n\n// Recomendaciones\nconst recomendaciones = [];\nif (!plugin_seo_ok) recomendaciones.push('⚠️ No se detectó plugin SEO activo (Rank Math o Yoast)');\nif (!robots_ok) recomendaciones.push('⚠️ robots.txt no encontrado o sin directivas — verificar que el sitio lo genera');\nelse if (!robots_tiene_sitemap && sitemap_url) recomendaciones.push(`⚠️ robots.txt existe pero no incluye directiva Sitemap: ${sitemap_url}`);\nif (!sitemap_url) recomendaciones.push('⚠️ Sitemap no encontrado en /wp-sitemap.xml ni /sitemap_index.xml — activar en el plugin SEO');\n\n// Contenido robots.txt ideal si falta la directiva de sitemap\nlet robots_sugerido = '';\nif (robots_ok && !robots_tiene_sitemap && sitemap_url) {\n  robots_sugerido = `Agregar esta línea al final de robots.txt:\nSitemap: ${sitemap_url}`;\n}\n\nreturn [{\n  json: {\n    tipo_contenido: ctx.tipo,\n    content_id: ctx.content_id,\n    plugin_seo,\n    plugin_seo_activo: plugin_seo_ok,\n    robots_txt_existe: robots_ok,\n    robots_tiene_directiva_sitemap: robots_tiene_sitemap,\n    sitemap_url: sitemap_url || 'No encontrado',\n    sitemap_tipo: sitemap_tipo || 'N/A',\n    recomendaciones: recomendaciones.length ? recomendaciones : ['✅ Todo en orden'],\n    robots_sugerido: robots_sugerido || null\n  }\n}];\n"
      }
    }
  ],
