    {
      "id": "cc38d76f-f27d-477f-a1f7-0a7953333ffb",
      "name": "🔧 Preparar Actualización",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('🔧 Consolidar Tipo').item.json;\nconst body = {};\n\nif (ctx.nuevo_titulo && ctx.nuevo_titulo.trim() !== '') {\n  body.title = ctx.nuevo_titulo.trim();\n}\nif (ctx.nuevo_contenido && ctx.nuevo_contenido.trim() !== '') {\n  body.content = ctx.nuevo_contenido.trim();\n}\n\n// Asignar imagen destacada si se subió correctamente\nlet media_id = null;\ntry {\n  const media = $('📸 Subir Imagen a Media Library').item.json;\n  if (media && media.id) {\n    body.featured_media = media.id;\n    media_id = media.id;\n  }\n} catch(e) {}\n\nreturn [{ json: { body: JSON.stringify(body), tipo: ctx.tipo, content_id: ctx.content_id, wp_site_url: ctx.wp_site_url, media_id } }];\n"
      }
    },
