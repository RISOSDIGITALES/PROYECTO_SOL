    {
      "id": "if-cot",
      "name": "🔀 ¿Cotizar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.todosRecolectados }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      }
    },
    {
      "id": "api-cot",
      "name": "💰 API Cotizador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://cratingcotiza.mdarthurdigital.com/api/cotizar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo_caja: $('Recibir Datos').item.json.tipoCajaApi || 'cajones_cerrados', cant: 1, largo: $('Recibir Datos').item.json.dimensiones?.largo || 100, ancho: $('Recibir Datos').item.json.dimensiones?.ancho || 50, alto: $('Recibir Datos').item.json.dimensiones?.alto || 50 }) }}",
        "options": {}
      }
    },
    {
      "id": "enrich",
      "name": "📝 Enriquecer con Precio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ],
      "parameters": {
        "jsCode": "const cotizacion = $input.item.json;\nconst ctx = $('Recibir Datos').item.json;\nconst precio = cotizacion?.data?.precio_total || cotizacion?.precio_total;\nlet mensajeFinal = ctx.mensaje;\n\nif (precio) {\n  const idioma = ctx.idiomaConversacion || 'español';\n  if (idioma === 'inglés') {\n    mensajeFinal += `\\n\\n💵 *Estimated price: $${precio} USD*\\n_This is an estimate based on the dimensions provided. The final price may vary depending on additional details._\\n\\nWould you like a Crating Express specialist to contact you for a formal quote?`;\n  } else {\n    mensajeFinal += `\\n\\n💵 *Precio estimado: $${precio} USD*\\n_Este es un estimado basado en las dimensiones indicadas. El precio final puede variar según detalles adicionales._\\n\\n¿Le gustaría que un especialista de Crating Express lo contacte para una cotización formal?`;\n  }\n}\n\nreturn [{ json: { ...ctx, mensaje: mensajeFinal, mensajeRespuesta: mensajeFinal, cotizadorEnviado: !!precio } }];"
      }
    },
    {
      "id": "passthrough",
      "name": "➡️ Sin Cotización",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        400
      ],
      "parameters": {
        "jsCode": "return [{ json: $input.first().json }]"
      }
    }
  ],
