        ],
        "parameters": {
          "jsCode": "const resp = $input.first().json;\nconst filename = $('🔧 Preparar Body PDF').first().json.filename;\nconst contenido = resp.candidates?.[0]?.content?.parts?.[0]?.text || 'No se pudo leer el documento.';\nconst texto = `[Documento PDF recibido: ${filename}]: ${contenido}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'document', filename, contenido },\n  media_type: 'document'\n}}];"
        }
