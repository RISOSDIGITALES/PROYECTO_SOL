      {
        "id": "sw06-gemini-image-body",
        "name": "🔧 Preparar Body Imagen",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1540,
          260
        ],
        "parameters": {
          "jsCode": "const d = $input.first().json;\nconst caption = d.caption ? `El cliente adjuntó este texto con la imagen: \"${d.caption}\". ` : '';\nconst prompt = `${caption}Eres el asistente de ventas Marco de Crating Express (empresa de embalaje industrial en Miami). Analiza esta imagen enviada por un cliente y extrae toda la información relevante para una cotización de embalaje: describe el objeto/artículo visible, sus dimensiones aproximadas si son visibles, materiales, estado, cualquier texto o etiqueta relevante, y cualquier detalle que ayude a cotizar un cajón o embalaje de madera. Sé específico y práctico.`;\n\nconst body = {\n  contents: [{\n    parts: [\n      { inlineData: { mimeType: d.mimeType, data: d.base64 } },\n      { text: prompt }\n    ]\n  }],\n  generationConfig: { temperature: 0.2, maxOutputTokens: 800 }\n};\n\nreturn [{ json: { body: JSON.stringify(body), geminiKey: d.geminiKey, mimeType: d.mimeType, caption: d.caption } }];"
        }
      },
