        ],
        "parameters": {
          "jsCode": "const resp = $input.first().json;\nconst descripcion = resp.candidates?.[0]?.content?.parts?.[0]?.text || 'No se pudo analizar la imagen.';\nconst caption = $('🔧 Preparar Body Imagen').first().json.caption || '';\nconst captionExtra = caption ? ` El cliente escribió: \"${caption}\".` : '';\nconst texto = `[Imagen recibida]:${captionExtra} ${descripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'image', descripcion },\n  media_type: 'image'\n}}];"
        }
      },
      {
        "id": "sw06-gemini-pdf-body",
        "name": "🔧 Preparar Body PDF",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1540,
          420
        ],
        "parameters": {
          "jsCode": "const d = $input.first().json;\nconst filename = d.filename || 'documento.pdf';\nconst prompt = `Eres el asistente Marco de Crating Express. Este PDF fue enviado por un cliente. Extrae y resume toda la información relevante para un servicio de embalaje industrial: dimensiones, pesos, tipo de artículo, especificaciones técnicas, fechas de envío, destino, y cualquier requerimiento especial. Presenta la información de forma clara y estructurada.`;\n\nconst body = {\n  contents: [{\n    parts: [\n      { inlineData: { mimeType: 'application/pdf', data: d.base64 } },\n      { text: prompt }\n    ]\n  }],\n  generationConfig: { temperature: 0.1, maxOutputTokens: 1200 }\n};\n\nreturn [{ json: { body: JSON.stringify(body), geminiKey: d.geminiKey, filename } }];"
        }
      },
