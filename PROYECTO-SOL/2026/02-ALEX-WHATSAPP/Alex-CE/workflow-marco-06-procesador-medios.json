        "parameters": {
          "jsCode": "const transcripcion = ($input.first().json.body || $input.first().json || '').toString().trim();\nconst texto = `[Audio transcrito]: ${transcripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'audio', transcripcion },\n  media_type: 'audio'\n}}];"
