    {
      "id": "sw06-audio-result",
      "name": "🔧 Resultado Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "jsCode": "const transcripcion = ($input.first().json.body || $input.first().json || '').toString().trim();\nconst texto = `[Audio transcrito]: ${transcripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'audio', transcripcion },\n  media_type: 'audio'\n}}];"
      }
    },
    {
      "id": "sw06-gemini-image-body",
      "name": "🔧 Preparar Body Imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst caption = d.caption ? `El cliente adjuntó este texto con la imagen: \"${d.caption}\". ` : '';\nconst prompt = `${caption}Eres el asistente de ventas Marco de Crating Express (empresa de embalaje industrial en Miami). Analiza esta imagen enviada por un cliente y extrae toda la información relevante para una cotización de embalaje: describe el objeto/artículo visible, sus dimensiones aproximadas si son visibles, materiales, estado, cualquier texto o etiqueta relevante, y cualquier detalle que ayude a cotizar un cajón o embalaje de madera. Sé específico y práctico.`;\n\nconst body = {\n  contents: [{\n    parts: [\n      { inlineData: { mimeType: d.mimeType, data: d.base64 } },\n      { text: prompt }\n    ]\n  }],\n  generationConfig: { temperature: 0.2, maxOutputTokens: 800 }\n};\n\nreturn [{ json: { body: JSON.stringify(body), geminiKey: d.geminiKey, mimeType: d.mimeType, caption: d.caption } }];"
      }
    },
    {
      "id": "sw06-gemini-image",
      "name": "🖼️ Gemini Vision: Imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $json.geminiKey }}",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sw06-image-result",
      "name": "🔧 Resultado Imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        260
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst descripcion = resp.candidates?.[0]?.content?.parts?.[0]?.text || 'No se pudo analizar la imagen.';\nconst caption = $('🔧 Preparar Body Imagen').first().json.caption || '';\nconst captionExtra = caption ? ` El cliente escribió: \"${caption}\".` : '';\nconst texto = `[Imagen recibida]:${captionExtra} ${descripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'image', descripcion },\n  media_type: 'image'\n}}];"
      }
    },
    {
      "id": "sw06-gemini-pdf-body",
      "name": "🔧 Preparar Body PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        420
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst filename = d.filename || 'documento.pdf';\nconst prompt = `Eres el asistente Marco de Crating Express. Este PDF fue enviado por un cliente. Extrae y resume toda la información relevante para un servicio de embalaje industrial: dimensiones, pesos, tipo de artículo, especificaciones técnicas, fechas de envío, destino, y cualquier requerimiento especial. Presenta la información de forma clara y estructurada.`;\n\nconst body = {\n  contents: [{\n    parts: [\n      { inlineData: { mimeType: 'application/pdf', data: d.base64 } },\n      { text: prompt }\n    ]\n  }],\n  generationConfig: { temperature: 0.1, maxOutputTokens: 1200 }\n};\n\nreturn [{ json: { body: JSON.stringify(body), geminiKey: d.geminiKey, filename } }];"
      }
    },
    {
      "id": "sw06-gemini-pdf",
      "name": "📄 Gemini: Leer PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $json.geminiKey }}",
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ $json.body }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "sw06-pdf-result",
      "name": "🔧 Resultado PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        420
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst filename = $('🔧 Preparar Body PDF').first().json.filename;\nconst contenido = resp.candidates?.[0]?.content?.parts?.[0]?.text || 'No se pudo leer el documento.';\nconst texto = `[Documento PDF recibido: ${filename}]: ${contenido}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'document', filename, contenido },\n  media_type: 'document'\n}}];"
      }
    },
    {
      "id": "sw06-convert-api",
      "name": "🔄 ConvertAPI: Office → Texto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        580
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://v2.convertapi.com/convert/{{ $json.mimeType.includes('spreadsheet') || $json.mimeType.includes('excel') ? 'xlsx' : ($json.mimeType.includes('presentation') ? 'pptx' : 'docx') }}/to/txt?Secret={{ $json.convertApiKey }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "options": {},
        "continueOnFail": true
      }
    },
    {
      "id": "sw06-office-result",
      "name": "🔧 Resultado Office",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        580
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst inp = $('🔧 Leer Binario y Tipo').first().json;\nconst filename = inp.filename || 'documento';\n\n// ConvertAPI response: { Files: [{ FileData: 'base64txt' }] }\nlet contenido = '';\ntry {\n  const fileData = resp.Files?.[0]?.FileData || '';\n  if (fileData) {\n    contenido = Buffer.from(fileData, 'base64').toString('utf8').slice(0, 3000);\n  }\n} catch(e) {}\n\nif (!contenido) {\n  contenido = 'No se pudo extraer el contenido del documento.';\n}\n\nconst texto = `[Documento Office recibido: ${filename}]: ${contenido}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'document', filename, contenido },\n  media_type: 'document'\n}}];"
      }
    },
    {
      "id": "sw06-video-fallback",
      "name": "🎬 Fallback Video/Desconocido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        740
      ],
      "parameters": {
        "jsCode": "const inp = $('🔧 Leer Binario y Tipo').first().json;\nconst tipo = inp.mediaCategory === 'video' ? 'video' : 'archivo';\nconst texto = tipo === 'video'\n  ? '[Video recibido]: El cliente envió un video. Por el momento no puedo analizar videos directamente. Si contiene información sobre las dimensiones o el artículo a embalar, por favor descríbelo en un mensaje de texto.'\n  : `[Archivo recibido: ${inp.filename || 'archivo'}]: El cliente envió un archivo en formato no soportado (${inp.mimeType}). Por favor pídele que lo envíe en PDF o imagen.`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: tipo, filename: inp.filename },\n  media_type: tipo\n}}];"
      }
    },
    {
      "id": "sw06-merge",
      "name": "🔀 Unir Resultados",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2200,
        420
      ],
      "parameters": {
        "mode": "passThrough",
        "output": "first"
      }
    },
    {
      "id": "sw06-output",
      "name": "📤 Devolver Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        420
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: {\n  texto: d.texto || '[Medio recibido pero no procesado]',\n  media_ref: d.media_ref || {},\n  media_type: d.media_type || 'unknown'\n}}];"
      }
    },
    {
      "id": "n_wa_config",
      "name": "🔑 Obtener Config WA (G54)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://apigrowth.mdarthurdigital.com/api/agent/wa/empresa-by-phone/{{ $json.phone_number_id || '1083260611538246' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer g54_agent_produccion_2026"
            }
          ]
        },
        "options": {}
      }
    }
