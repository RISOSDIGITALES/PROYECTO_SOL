    {
      "id": "sw06-prepare-binary",
      "name": "🔧 Leer Binario y Tipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const inp = $('📥 Recibir Datos Medio').first().json;\nconst binary = $input.first().binary;\n\n// Get base64 from binary data\nconst binaryKey = Object.keys(binary || {})[0] || 'data';\nconst fileData = binary?.[binaryKey];\nconst base64 = fileData?.data || '';\nconst mimeType = inp.mime_type || fileData?.mimeType || 'application/octet-stream';\nconst filename = inp.filename || fileData?.fileName || 'archivo';\nconst caption = inp.caption || '';\nconst geminiKey = inp.gemini_api_key || $vars.GEMINI_API_KEY || '';\nconst convertApiKey = inp.convert_api_key || '';\n\n// Classify type\nlet mediaCategory;\nif (mimeType.startsWith('image/')) {\n  mediaCategory = 'image';\n} else if (mimeType.startsWith('audio/') || mimeType.startsWith('video/ogg')) {\n  mediaCategory = 'audio';\n} else if (mimeType === 'application/pdf') {\n  mediaCategory = 'pdf';\n} else if (['application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n            'application/msword',\n            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n            'application/vnd.ms-excel',\n            'application/vnd.openxmlformats-officedocument.presentationml.presentation'\n           ].includes(mimeType)) {\n  mediaCategory = 'office';\n} else if (mimeType.startsWith('video/')) {\n  mediaCategory = 'video';\n} else {\n  mediaCategory = 'unknown';\n}\n\nreturn [{ json: { base64, mimeType, filename, caption, mediaCategory, geminiKey, convertApiKey }, binary }];"
      }
    },
    {
