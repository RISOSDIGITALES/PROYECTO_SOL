    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst post_id = b.post_id;\nconst company_id = b.company_id;\nconst fecha_programada = b.fecha_programada;\nconst cancelado = b.cancelado === true;\n\nif (!cancelado && !fecha_programada) {\n  throw new Error('fecha_programada es obligatoria para programar la alarma (salvo que sea una cancelación con cancelado:true)');\n}\n\nreturn [{ json: { post_id, company_id, fecha_programada, cancelado } }];"
      },
