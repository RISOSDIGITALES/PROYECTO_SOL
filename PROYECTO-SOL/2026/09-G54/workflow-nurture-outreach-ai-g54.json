      {
        "id": "armar-resumen",
        "name": "📤 Armar Resumen",
        "type": "n8n-nodes-base.code",
        "position": [
          1760,
          110
        ],
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const items = $input.all();\nif (items.length === 1 && items[0].json.sinLeads) {\n  return [{ json: { ok: true, enviados: 0, fallidos: 0, motivo: items[0].json.motivo } }];\n}\nconst fallidos = items.filter(i => i.json.error).length;\nconst exitosos = items.length - fallidos;\nconst errores = items.filter(i => i.json.error).map(i => (i.json.error.message || '').slice(0,200));\nreturn [{ json: { ok: true, enviados: exitosos, fallidos, errores: fallidos ? errores : undefined } }];"
        }
