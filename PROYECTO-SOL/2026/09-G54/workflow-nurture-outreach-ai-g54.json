    {
      "id": "filtrar-armar",
      "name": "🔍 Filtrar y Armar Emails",
      "type": "n8n-nodes-base.code",
      "position": [
        1100,
        110
      ],
      "typeVersion": 2,
      "parameters": {
        "jsCode": "\nconst params = $('🔧 Extraer Parámetros').first().json;\nconst modo = params.modo;\n\nlet empresa = {};\ntry { empresa = $('📊 Obtener Empresa').first().json.data || {}; } catch (e) {}\nconst empresaNombre = empresa.nombre || 'nuestra empresa';\nconst empresaWeb = empresa.website || '';\nconst empresaProp = empresa.value_proposition || '';\n\n// Blog: post más reciente (solo si modo === 'blog')\nlet post = null;\nif (modo === 'blog') {\n  try {\n    const cms = $('🔗 Obtener CMS WordPress').first().json.data;\n    if (!cms || !cms.is_active) {\n      return [{ json: { sinLeads: true, motivo: 'La empresa no tiene WordPress conectado (Ajustes → CMS Integrations) — no hay ningún blog real que compartir.' } }];\n    }\n    const first = $('📰 WP: Obtener Posts').first().json;\n    if (!first) {\n      return [{ json: { sinLeads: true, motivo: 'El blog de la empresa no tiene ningún post publicado todavía.' } }];\n    }\n    const media = first._embedded && first._embedded['wp:featuredmedia'] && first._embedded['wp:featuredmedia'][0];\n    post = {\n      id: first.id,\n      titulo: (first.title && first.title.rendered) || '',\n      extracto: ((first.excerpt && first.excerpt.rendered) || '').replace(/<[^>]+>/g, '').trim(),\n      url: first.link,\n      imagen: media ? media.source_url : '',\n    };\n  } catch (e) {\n    return [{ json: { sinLeads: true, motivo: 'No se pudo leer el blog real de la empresa (' + (e.message || e) + ').' } }];\n  }\n}\n\n// Board CRM\nlet board = {};\ntry { board = $('📋 Obtener Board CRM').first().json || {}; } catch (e) {}\nconst excluidas = ['closed', 'lost'];\nlet deals = [];\nfor (const etapa of Object.keys(board)) {\n  if (excluidas.includes(etapa)) continue;\n  const arr = Array.isArray(board[etapa]) ? board[etapa] : [];\n  for (const d of arr) deals.push(d);\n}\n\n// Filtrar por modo\nlet candidatos = [];\nif (modo === 'outreach') {\n  // Primer contacto en frío: solo leads recién prospectados, nunca contactados\n  candidatos = deals.filter(d => d.email && d.origen === 'prospeccion' && !(d.notas || '').includes('outreach_enviado'));\n} else {\n  // Nutrir con el blog: cualquier lead activo con email, que no haya recibido YA este mismo post\n  const marker = 'blog:' + (post ? post.id : '');\n  candidatos = deals.filter(d => d.email && !(d.notas || '').includes(marker));\n}\n\nif (candidatos.length === 0) {\n  const motivo = modo === 'outreach'\n    ? 'No hay leads nuevos de prospección con email pendientes de un primer contacto.'\n    : 'No hay ningún lead con email pendiente de recibir este post — ya se les mandó, o no hay ningún lead con email guardado todavía.';\n  return [{ json: { sinLeads: true, motivo } }];\n}\n\n// Armar el email por cada lead (personalizado)\nconst salida = candidatos.map(d => {\n  const nombre = (d.nombre || '').split(' ')[0] || 'hola';\n  let asunto, html, texto, notaNueva;\n\n  if (modo === 'outreach') {\n    asunto = `${empresaNombre} — nos encantaría ayudarte`;\n    html = `<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:0 auto;color:#222;\">\n<p>Hola ${nombre},</p>\n<p>Somos <strong>${empresaNombre}</strong>${empresaProp ? ' — ' + empresaProp : ''}.</p>\n<p>Vimos tu negocio y creemos que podríamos serte útiles. Si te interesa saber más, respondé este correo o visitá <a href=\"${empresaWeb}\">${empresaWeb}</a>.</p>\n<p>Saludos,<br>${empresaNombre}</p>\n</div>`;\n    texto = `Hola ${nombre}, somos ${empresaNombre}. ${empresaProp} Más info: ${empresaWeb}`;\n    notaNueva = ((d.notas ? d.notas + ' | ' : '') + 'outreach_enviado ' + new Date().toISOString().slice(0,10)).slice(0, 1000);\n  } else {\n    asunto = post.titulo ? `${empresaNombre} — ${post.titulo}` : `Novedades de ${empresaNombre}`;\n    html = `<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:0 auto;color:#222;\">\n<p>Hola ${nombre},</p>\n<h2 style=\"margin:0 0 12px;font-size:19px;color:#222;\">${post.titulo}</h2>\n${post.imagen ? `<img src=\"${post.imagen}\" alt=\"${post.titulo}\" style=\"width:100%;border-radius:6px;margin-bottom:12px;\" />` : ''}\n<p>${post.extracto}</p>\n<p><a href=\"${post.url}\">Leer la nota completa →</a></p>\n<p>Saludos,<br>${empresaNombre}</p>\n</div>`;\n    texto = `${post.titulo}\\n\\n${post.extracto}\\n\\nLeer más: ${post.url}`;\n    notaNueva = ((d.notas ? d.notas + ' | ' : '') + 'blog:' + post.id + ' enviado ' + new Date().toISOString().slice(0,10)).slice(0, 1000);\n  }\n\n  return {\n    json: {\n      deal_id: d.id,\n      email: d.email,\n      asunto,\n      html,\n      texto,\n      notas_nueva: notaNueva,\n    }\n  };\n});\n\nreturn salida;\n"
      }
    },
