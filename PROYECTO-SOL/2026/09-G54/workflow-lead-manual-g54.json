      {
        "parameters": {
          "jsCode": "const body = $input.item.json.body || {};\n\nconst companyId = String(body.company_id || '1');\nconst nombre = String(body.nombre || '').trim();\nconst canal = String(body.canal || 'otro').toLowerCase();\nconst contacto = String(body.contacto || '').trim();\nconst resumen = String(body.resumen || '').trim();\nconst clasificacionRaw = String(body.clasificacion || 'tibio').toLowerCase();\n\n// canal -> origen valido del enum de crm_deals (whatsapp/web/manual/facebook/instagram)\nconst origenMap = { whatsapp: 'whatsapp', facebook: 'facebook', instagram: 'instagram', telegram: 'manual', llamada: 'manual', correo: 'manual', otro: 'manual' };\nconst origen = origenMap[canal] || 'manual';\n\n// clasificacion -> temperatura valida del CRM (bajo/medio/alto)\nconst temperaturaMap = { frio: 'bajo', tibio: 'medio', caliente: 'alto' };\nconst temperatura = temperaturaMap[clasificacionRaw] || 'medio';\n\n// clave de contacto: si \"contacto\" ya parece un telefono real (solo digitos, 8+), se usa tal cual;\n// si no (email, usuario, texto libre) se prefija para no confundirlo con un telefono real,\n// mismo criterio ya usado en Community AI para IDs de Facebook (item 152 del proyecto)\nconst soloDigitos = contacto.replace(/[^0-9]/g, '');\nconst esTelefonoReal = soloDigitos.length >= 8 && soloDigitos.length === contacto.replace(/[\\s()+-]/g,'').length;\nconst phone = esTelefonoReal ? soloDigitos : ('manual_' + canal + '_' + Date.now());\n\nreturn [{ json: { companyId, nombre, canal, contacto, resumen, origen, temperatura, phone } }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
