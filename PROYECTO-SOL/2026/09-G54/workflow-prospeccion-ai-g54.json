    "jsCode": "\nconst lead = $('🧹 Formatear Lead').item.json;\nlet email = '';\ntry {\n  const emails = $json.data?.emails || [];\n  if (emails.length > 0) {\n    const sorted = [...emails].sort((a, b) => (b.confidence || 0) - (a.confidence || 0));\n    email = sorted[0].value || '';\n  }\n} catch (e) {}\nreturn [{ json: { ...lead, email, origen_email: email ? 'hunter' : '' } }];\n"
