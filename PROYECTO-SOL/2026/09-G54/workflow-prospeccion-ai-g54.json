   "id": "armar-resumen",
   "name": "📤 Armar Resumen",
   "type": "n8n-nodes-base.code",
   "position": [
    6160,
    -80
   ],
   "typeVersion": 2,
   "parameters": {
    "jsCode": "\nconst raw = $input.all();\nconst items = (raw[0] && raw[0].json && raw[0].json.data) ? raw[0].json.data : raw.map(i => i.json);\n\n// Caso de salida temprana: un solo item con sinResultados/valido:false, sin ningún lead real procesado\nif (items.length === 1 && (items[0].sinResultados === true || items[0].valido === false)) {\n  return [{ json: { ok: true, encontrados: 0, guardados: 0, motivo: items[0].motivo } }];\n}\n\nlet encontrados = items.length;\nlet sinContacto = 0, sinTelefono = 0, conEmail = 0, sinEmail = 0, guardadosOk = 0, guardadosFallidos = 0;\n\nfor (const it of items) {\n  if (it.descartado) { sinContacto++; continue; }\n  if (it.tiene_telefono === false) { sinTelefono++; if (it.email) conEmail++; else sinEmail++; continue; }\n  if (it.guardado_confirmado === true) { guardadosOk++; if (it.email) conEmail++; else sinEmail++; continue; }\n  if (it.guardado_confirmado === false) { guardadosFallidos++; if (it.email) conEmail++; else sinEmail++; continue; }\n}\n\nreturn [{ json: {\n  ok: true,\n  encontrados,\n  sin_contacto: sinContacto,\n  sin_telefono: sinTelefono,\n  con_email: conEmail,\n  sin_email: sinEmail,\n  guardados: guardadosOk,\n  guardados_fallidos: guardadosFallidos,\n} }];\n"
   }
  },
