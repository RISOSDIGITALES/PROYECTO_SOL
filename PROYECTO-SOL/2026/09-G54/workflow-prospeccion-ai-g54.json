   "typeVersion": 2,
   "parameters": {
    "jsCode": "\nconst resp = $json;\nconst status = resp.status || '';\n\nif (status === 'REQUEST_DENIED') {\n  return [{ json: { sinResultados: true, motivo: 'Google Places rechazó la búsqueda — falta configurar una API key real (GOOGLE_PLACES_API_KEY vacía o inválida). ' + (resp.error_message || '') } }];\n}\nif (status === 'OVER_QUERY_LIMIT') {\n  return [{ json: { sinResultados: true, motivo: 'Google Places devolvió OVER_QUERY_LIMIT — se agotó la cuota real de la API key configurada.' } }];\n}\nif (status !== 'OK' || !Array.isArray(resp.results) || resp.results.length === 0) {\n  return [{ json: { sinResultados: true, motivo: 'Google Places no encontró ningún negocio real para esta búsqueda (status: ' + status + ').' } }];\n}\nreturn resp.results.map(r => ({ json: r }));\n"
   }
