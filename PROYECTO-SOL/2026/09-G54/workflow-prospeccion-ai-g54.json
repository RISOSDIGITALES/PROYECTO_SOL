  {
   "id": "preparar-payload",
   "name": "🔧 CRM: Preparar Payload (Prospección)",
   "type": "n8n-nodes-base.code",
   "position": [
    4840,
    -180
   ],
   "typeVersion": 2,
   "parameters": {
    "jsCode": "\nconst lead = $json;\n\nlet query = '';\ntry { query = $('\\U0001F527 Construir Query de Búsqueda').item.json.query || ''; } catch (e) {}\nlet company_id = null;\ntry { company_id = Number($('\\U0001F527 Extraer Parámetros').item.json.company_id); } catch (e) {}\n\nif (!lead.telefono) {\n  return [{ json: { tiene_telefono: false, nombre: lead.nombre, email: lead.email || '', motivo: 'Se encontró el negocio pero sin teléfono real — el CRM de G54 guarda leads por teléfono, no se pudo persistir.' } }];\n}\n\nconst origenLabel = ({\n  hunter: 'Hunter.io',\n  scraping_contact: 'la página /contact del sitio',\n  scraping_about: 'la página /about del sitio',\n  '': 'ninguna fuente',\n})[lead.origen_email || ''] || 'ninguna fuente';\n\nconst notas = [\n  'Lead encontrado por Prospección AI' + (query ? (' (búsqueda: \"' + query + '\")') : '') + '.',\n  lead.web ? ('Sitio: ' + lead.web) : 'Sin sitio web conocido.',\n  lead.email ? ('Email encontrado vía ' + origenLabel + ': ' + lead.email) : 'No se encontró ningún email real.',\n  lead.rating ? ('Rating en Google: ' + lead.rating) : '',\n  lead.direccion ? ('Dirección: ' + lead.direccion) : '',\n].filter(Boolean).join(' ');\n\nreturn [{ json: {\n  tiene_telefono: true,\n  company_id,\n  telefono: lead.telefono,\n  nombre: lead.nombre,\n  origen: 'manual',\n  temperatura: 'bajo',\n  notas,\n  email: lead.email || '',\n} }];\n"
   }
  },
