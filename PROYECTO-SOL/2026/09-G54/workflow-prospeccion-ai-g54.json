   "id": "construir-query",
   "name": "🔧 Construir Query de Búsqueda",
   "type": "n8n-nodes-base.code",
   "position": [
    660,
    0
   ],
   "typeVersion": 2,
   "parameters": {
    "jsCode": "\nlet empresa = {};\ntry { empresa = $('📊 Obtener Empresa').item.json.data || {}; } catch (e) {}\n\nconst industry = (empresa.industry || '').trim();\nconst ciudad = (empresa.base_city || '').trim();\nconst geografia = (empresa.geography || '').trim();\nconst targetMarket = (empresa.target_market || '').trim();\n\n// keywords reales de la empresa (si existen) - se usa la primera como termino de busqueda\n// de negocio, nunca un rubro inventado por nosotros\nlet keyword = '';\ntry {\n  const kws = empresa.target_keywords;\n  if (Array.isArray(kws) && kws.length) keyword = String(kws[0]).trim();\n  else if (typeof kws === 'string' && kws.trim()) keyword = kws.split(',')[0].trim();\n} catch (e) {}\n\n// El termino de \"que buscar\" sale de la industria real, o si no existe, de la primera\n// keyword real, o si no existe, del target_market real. Nunca un valor inventado.\nconst termino = industry || keyword || targetMarket;\nconst lugar = ciudad || geografia;\n\nif (!termino) {\n  return [{ json: { valido: false, motivo: 'La empresa no tiene industry, target_keywords ni target_market configurados en G54 — no hay ningún dato real desde el cual construir una búsqueda.' } }];\n}\nif (!lugar) {\n  return [{ json: { valido: false, motivo: 'La empresa no tiene base_city ni geography configurados en G54 — no hay ninguna ciudad/zona real donde buscar.' } }];\n}\n\nconst query = termino + ' ' + lugar;\nreturn [{ json: { valido: true, query, termino, lugar } }];\n"
   }
  },
