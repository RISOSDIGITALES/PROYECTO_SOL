    {
      "id": "extract",
      "name": "🔧 Extraer Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ],
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst entry = body.entry?.[0];\nconst changes = entry?.changes?.[0];\nconst value = changes?.value;\nconst message = value?.messages?.[0];\nif (!message) return [{ json: { skip: true } }];\nconst telefono = message.from;\nconst texto = message.text?.body || '';\nconst messageId = message.id;\nconst nombreContacto = value?.contacts?.[0]?.profile?.name || '';\nconst seen = $getWorkflowStaticData('global');\nif (!seen.msgIds) seen.msgIds = {};\nif (seen.msgIds[messageId]) return [{ json: { skip: true } }];\nseen.msgIds[messageId] = Date.now();\nObject.keys(seen.msgIds).forEach(k => { if (Date.now() - seen.msgIds[k] > 3600000) delete seen.msgIds[k]; });\nreturn [{ json: { telefono, texto, messageId, nombreContacto, skip: false } }];"
      }
    },
