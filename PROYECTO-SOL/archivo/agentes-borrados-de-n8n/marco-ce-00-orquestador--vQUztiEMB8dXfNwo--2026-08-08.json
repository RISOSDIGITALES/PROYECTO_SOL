      ],
      "parameters": {
        "url": "https://api.airtable.com/v0/appUOYi54iBfaDcLn/WhatsApp_Leads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({Estado}='En calificación', {Ultima_Actividad}<DATEADD(NOW(),-20,'hours'))"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
