      },
      "id": "4987f08f-0af2-4133-85b8-58445b517a52",
      "name": "🔔 Webhook VAPI",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -624,
        160
      ],
      "webhookId": "vapi-ce-prompt"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst msg = body.message || body;\nconst eventType = msg.type || msg.event || '';\n\n// VAPI llama con 'assistant-request' al inicio de cada llamada\nconst esInicio = eventType === 'assistant-request';\n\nreturn [{ json: { esInicio, eventType, rawBody: body } }];"
      },
      "id": "eca7eec4-93ae-4f24-b0d9-ef9d8c0a8c3f",
      "name": "🔍 Detectar Tipo de Evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-inicio",
              "leftValue": "={{ $json.esInicio }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e2518177-4c53-4cc6-b2cc-0cd177aaf45d",
      "name": "❓ ¿Es inicio de llamada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -192,
        160
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "documentURL": "https://docs.google.com/document/d/1TCQis3T6FIMp5vcNnPLSCxoggsPrd0EkRiMa84yYbnw/edit"
      },
      "id": "4411447b-c5a6-4dbd-9fb1-731db1e8910f",
      "name": "📄 Leer Google Doc",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        32,
        48
      ],
      "credentials": {
        "googleDocsOAuth2Api": {
          "id": "F7zXp5HLbw5kGcN3",
          "name": "Google Docs account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const docContent = $input.first().json.body?.content || '';\n\n// Extraer texto plano del documento\nlet textoDoc = '';\nif (Array.isArray(docContent)) {\n  for (const elemento of docContent) {\n    const parrafo = elemento.paragraph;\n    if (parrafo?.elements) {\n      for (const el of parrafo.elements) {\n        if (el.textRun?.content) {\n          textoDoc += el.textRun.content;\n        }\n      }\n    }\n  }\n} else if (typeof docContent === 'string') {\n  textoDoc = docContent;\n}\n\ntextoDoc = textoDoc.trim();\n\n// Armar el prompt completo para VAPI\n// El prompt del doc se inyecta como contexto de conocimiento\n// La personalidad de Alex sigue en el prompt interno de VAPI\nconst promptContexto = `A continuación tienes toda la información actualizada de Crating Express. Úsala como tu base de conocimiento para responder preguntas de clientes con precisión:\\n\\n${textoDoc}\\n\\nRecuerda: si no sabes algo con certeza, ofrece conectar al cliente con el equipo por WhatsApp o email.`;\n\nreturn [{ json: { promptContexto } }];"
      },
      "id": "faa12b2e-fe0d-4f01-b129-37d98b45a220",
      "name": "🔧 Formatear Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        48
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ assistant: { model: { messages: [ { role: 'system', content: $json.promptContexto } ] } } }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "59e6bea0-c019-425d-84e5-bbc1d85264e9",
      "name": "✅ Enviar Prompt a VAPI",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        48
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true }) }}",
