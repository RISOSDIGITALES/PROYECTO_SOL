# Clave de la API (obligatoria para "servir"): Authorization: Bearer <VIGIA_TOKEN>
VIGIA_TOKEN=
VIGIA_PUERTO=8080
# Reloj: revisión completa una vez al día a esta hora; rápida cada hora en este minuto
VIGIA_ZONA=America/New_York
VIGIA_HORA_COMPLETA=06:05
VIGIA_MINUTO_RAPIDA=17
VIGIA_MAX_PAGINAS=25
VIGIA_MAX_ENLACES=250
# Correo (opcional). Gmail: smtp.gmail.com, 587 y una contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Telegram (opcional): token del bot; a cada sitio se le inscribe el chat_id
TELEGRAM_BOT_TOKEN=
# Webhook (opcional): firma HMAC-SHA256 del cuerpo en el header X-Vigia-Firma
VIGIA_WEBHOOK_SECRET=
# Google Safe Browsing (opcional, clave gratis de Google Cloud)
GOOGLE_SAFEBROWSING_KEY=
