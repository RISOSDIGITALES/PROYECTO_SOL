# ── Base de datos (MariaDB / MySQL) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=planilla_nicaragua

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Cambia este valor por cualquier cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# ── Puerto del servidor (opcional, default: 3000) ─────────────────────────────
# PORT=3000

# ── URL pública de la app (para enlaces en correos) ───────────────────────────
APP_URL=http://localhost:3000

# ── SMTP para envío de correos ────────────────────────────────────────────────
# Funciones: recuperación de contraseña, reporte de planilla PDF, recibo PDF por correo.
# Si no se configura, los correos se omiten silenciosamente.
#
# ── OPCIÓN A: Mailtrap (recomendado para pruebas / desarrollo) ────────────────
# Mailtrap captura todos los correos en una bandeja de prueba — ningún email
# sale al mundo real. Perfecto para probar sin riesgo.
#
# Pasos:
#   1. Crear cuenta gratis en https://mailtrap.io
#   2. Email Testing → Inboxes → (tu inbox) → ícono ⚙️ → pestaña SMTP Settings
#   3. Copiar las credenciales que aparecen ahí y pegarlas abajo:
#
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=<pega_aqui_el_username_de_mailtrap>
SMTP_PASS=<pega_aqui_el_password_de_mailtrap>
SMTP_FROM=noreply@nomify.app

# ── OPCIÓN B: Gmail (para producción) ─────────────────────────────────────────
# Requiere "Contraseña de aplicación" (no tu password normal).
# Generarla en: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
#
# Usar puerto 465 (SSL directo), NO el 587: muchos servidores/ISP bloquean el
# 587 de salida y la conexión falla con ETIMEDOUT aunque la contraseña esté bien.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_contrasena_de_app_16_caracteres
# SMTP_FROM=tucorreo@gmail.com