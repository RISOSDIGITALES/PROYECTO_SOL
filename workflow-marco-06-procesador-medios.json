    {
      "id": "sw06-image-result",
      "name": "🔧 Resultado Imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        260
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst descripcion = resp.choices?.[0]?.message?.content || 'No se pudo analizar la imagen.';\nconst caption = $('🔧 Preparar Body Imagen').first().json.caption || '';\nconst captionExtra = caption ? ` El cliente escribió: \"${caption}\".` : '';\nconst texto = `[Imagen recibida]:${captionExtra} ${descripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'image', descripcion },\n  media_type: 'image'\n}}];"
      }
    },
    {
      "id": "sw06-pdf-result",
      "name": "🔧 Resultado PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        420
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst inp = $('🔧 Leer Binario y Tipo').first().json;\nconst filename = inp.filename || 'documento.pdf';\n\nlet contenido = '';\ntry {\n  const fileData = resp.Files?.[0]?.FileData || '';\n  if (fileData) {\n    contenido = Buffer.from(fileData, 'base64').toString('utf8').slice(0, 3000);\n  }\n} catch(e) {}\n\nif (!contenido) {\n  contenido = 'No se pudo extraer el contenido del documento.';\n}\n\nconst texto = `[Documento PDF recibido: ${filename}]: ${contenido}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'document', filename, contenido },\n  media_type: 'document'\n}}];"
      }
    },
    {
      "id": "sw06-convert-api",
