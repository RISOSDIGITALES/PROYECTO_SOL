      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        580
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://v2.convertapi.com/convert/{{ $json.mimeType.includes('spreadsheet') || $json.mimeType.includes('excel') ? 'xlsx' : ($json.mimeType.includes('presentation') ? 'pptx' : 'docx') }}/to/txt?Secret={{ $json.convertApiKey }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "sendBinaryData": true,
        "binaryPropertyName": "data",
        "options": {},
        "continueOnFail": true
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "sw06-office-result",
      "name": "🔧 Resultado Office",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        580
      ],
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst inp = $('🔧 Leer Binario y Tipo').first().json;\nconst filename = inp.filename || 'documento';\n\n// ConvertAPI response: { Files: [{ FileData: 'base64txt' }] }\nlet contenido = '';\ntry {\n  const fileData = resp.Files?.[0]?.FileData || '';\n  if (fileData) {\n    contenido = Buffer.from(fileData, 'base64').toString('utf8').slice(0, 3000);\n  }\n} catch(e) {}\n\nif (!contenido) {\n  contenido = 'No se pudo extraer el contenido del documento.';\n}\n\nconst texto = `[Documento Office recibido: ${filename}]: ${contenido}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'document', filename, contenido },\n  media_type: 'document'\n}}];"
      }
    },
    {
      "id": "sw06-video-fallback",
      "name": "🎬 Fallback Video/Desconocido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        740
      ],
      "parameters": {
        "jsCode": "const inp = $('🔧 Leer Binario y Tipo').first().json;\nconst tipo = inp.mediaCategory === 'video' ? 'video' : 'archivo';\nconst texto = tipo === 'video'\n  ? '[Video recibido]: El cliente envió un video. Por el momento no puedo analizar videos directamente. Si contiene información sobre las dimensiones o el artículo a embalar, por favor descríbelo en un mensaje de texto.'\n  : `[Archivo recibido: ${inp.filename || 'archivo'}]: El cliente envió un archivo en formato no soportado (${inp.mimeType}). Por favor pídele que lo envíe en PDF o imagen.`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: tipo, filename: inp.filename },\n  media_type: tipo\n}}];"
      }
    },
    {
      "id": "sw06-merge",
