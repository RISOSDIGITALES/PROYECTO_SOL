    {
      "id": "sw06-audio-result",
      "name": "🔧 Resultado Audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "jsCode": "const transcripcion = ($input.first().json.body || $input.first().json || '').toString().trim();\nconst texto = `[Audio transcrito]: ${transcripcion}`;\nreturn [{ json: {\n  texto,\n  media_ref: { type: 'audio', transcripcion },\n  media_type: 'audio'\n}}];"
      }
    },
    {
      "id": "sw06-gemini-image-body",
      "name": "🔧 Preparar Body Imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        260
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst caption = d.caption ? `El cliente adjuntó este texto con la imagen: \"${d.caption}\". ` : '';\nconst prompt = `${caption}Eres el asistente de ventas Marco de Crating Express (empresa de embalaje industrial en Miami). Analiza esta imagen enviada por un cliente y extrae toda la información relevante para una cotización de embalaje: describe el objeto/artículo visible, sus dimensiones aproximadas si son visibles, materiales, estado, cualquier texto o etiqueta relevante, y cualquier detalle que ayude a cotizar un cajón o embalaje de madera. Sé específico y práctico.`;\n\nlet proxyUrl;\ntry {\n  const tgUrl = $('🔧 TG: Construir URL Descarga').first().json.file_url;\n  proxyUrl = tgUrl || `https://n8n.mdarthurdigital.com/webhook/media-proxy-g54?media_id=${encodeURIComponent(d.media_id)}&phone_number_id=${encodeURIComponent(d.phone_number_id)}&secret=g54_agent_produccion_2026`;\n} catch (e) {\n  proxyUrl = `https://n8n.mdarthurdigital.com/webhook/media-proxy-g54?media_id=${encodeURIComponent(d.media_id)}&phone_number_id=${encodeURIComponent(d.phone_number_id)}&secret=g54_agent_produccion_2026`;\n}\n\nconst body = {\n  model: 'meta-llama/llama-4-scout-17b-16e-instruct',\n  messages: [{\n    role: 'user',\n    content: [\n      { type: 'text', text: prompt },\n      { type: 'image_url', image_url: { url: proxyUrl } }\n    ]\n  }],\n  temperature: 0.2,\n  max_tokens: 800\n};\n\nreturn [{ json: { body: JSON.stringify(body), mimeType: d.mimeType, caption: d.caption } }];"
      }
    },
    {
      "id": "sw06-gemini-image",
      "name": "🖼️ Groq Vision: Imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
