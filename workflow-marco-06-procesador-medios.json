        880,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('🔑 Obtener Config WA (G54)').item.json.wa_access_token || $('📥 Recibir Datos Medio').item.json.fb_access_token }}"
            }
