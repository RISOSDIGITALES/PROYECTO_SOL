# --- Vox54 backend ---
VOX54_API_BASE=http://localhost:8000
WORKER_SECRET=cambiar-esto-y-que-coincida-con-worker_secret-del-backend

# --- LiveKit (obligatorio para correr de verdad — sin esto el worker no
# puede conectarse a ninguna sala real, ni en LiveKit Cloud ni self-hosted) ---
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Keys compartidas de plataforma — fallback cuando un negocio no trae
# su propia API key en BotConfig (mismo criterio que ai_api_key ya usa hoy).
# Sin ninguna de estas, cualquier negocio que use el proveedor correspondiente
# sin su propia key va a fallar al armar el pipeline — a propósito, no se
# inventa ninguna llamada con una key vacía. ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
