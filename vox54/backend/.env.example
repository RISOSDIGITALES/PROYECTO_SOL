# Copiar a .env y completar con valores reales — nunca commitear el .env real
DATABASE_URL=sqlite:///./vox54.db
JWT_SECRET=cambia_esto_por_un_secreto_real_y_largo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Secreto compartido que valida al worker de LiveKit Agents (ver vox54/worker/.env)
# — debe ser idéntico en los dos lados.
WORKER_SECRET=cambia_esto_y_que_coincida_con_el_worker
# Orígenes reales permitidos por CORS, separados por coma. En desarrollo
# alcanza con el default (Vite local) — al desplegar de verdad, fijar acá
# el dominio real del panel, nunca dejar localhost en un backend expuesto.
CORS_ORIGINS=http://localhost:5173
# Opcional — sin esto, la subida de documentos sigue funcionando igual
# (extracción de texto + búsqueda semántica), solo que sin resumen ni
# sugerencias de servicios generadas por IA (documents.py se salta esa
# parte sola). Mismo proveedor y misma key que vox54/worker/.env.
GROQ_API_KEY=
